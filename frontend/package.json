{
  "name": "@hackatl/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "transport": "npm ci --prefix transport && npm run build --prefix transport",
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
