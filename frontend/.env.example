# Frontend server environment (Vercel project "ari-ai"). Copy to .env.local for local runs.
# NEVER commit real values.

# Control-plane API the /api/v1 proxy forwards to (Railway in production).
BACKEND_ORIGIN=http://127.0.0.1:8000

# Live commit analysis (POST /api/analyze): required for /connect/.../commit/<sha>.
ANTHROPIC_API_KEY=replace-me
# Optional: model override (default claude-haiku-5-5).
ANTHROPIC_MODEL=
# Optional: GitHub token for private repositories and higher API rate limits.
GITHUB_TOKEN=

# Demo account access code for /access (server-only; unset = demo closed).
DEMO_ACCESS_CODE=
# Build flag: demo-only deployment without a backend.
NEXT_PUBLIC_DEMO_ONLY=
