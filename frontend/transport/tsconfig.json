{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "resolveJsonModule": true,
    "declaration": true, "rootDir": "../..", "outDir": "dist", "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
