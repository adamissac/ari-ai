{
  "_comment": [
    "Sandbox build recipe for the payments-lite target, consumed by",
    "security_agents (ScopeTarget.build_recipe_ref). This is operator-provided",
    "configuration that an AuthorizedScope approves: it names the target's",
    "entry points, its synthetic fixture identities and the fixture resources a",
    "reviewed check template may reference. It is NOT an answer key: it says",
    "nothing about which routes are correct (that is labels.yaml, which the",
    "platform never reads). Probe and Verify may only name ids from this file.",
    "Owner: Alan (security-agents). Shared directory: announce changes.",
    "The /refunds/{refund_id} negative needs a seeded refund; template v0 only references resources that exist in the seeded store, so that route is intentionally absent."
  ],
  "recipe_version": 1,
  "kind": "python_asgi",
  "target_dir": "target",
  "app_factory": "payments_lite.app:create_app",
  "test_command": [
    "-q",
    "tests"
  ],
  "identities": {
    "alice": {
      "auth_header": "Bearer fixture-token-alice",
      "customer_id": "cus_alice"
    },
    "bob": {
      "auth_header": "Bearer fixture-token-bob",
      "customer_id": "cus_bob"
    }
  },
  "resources": {
    "payment": {
      "alice": {
        "id": "pay_a1",
        "amount": "120.00",
        "amount_field": "amount",
        "refunded_field": "refunded"
      },
      "bob": {
        "id": "pay_b1",
        "amount": "80.00",
        "amount_field": "amount",
        "refunded_field": "refunded"
      }
    },
    "customer": {
      "alice": {
        "id": "cus_alice"
      },
      "bob": {
        "id": "cus_bob"
      }
    }
  },
  "routes": [
    {
      "id": "payment_detail",
      "method": "GET",
      "path_template": "/payments/{payment_id}",
      "resource": "payment"
    },
    {
      "id": "customer_detail",
      "method": "GET",
      "path_template": "/customers/{customer_id}",
      "resource": "customer"
    },
    {
      "id": "payment_list",
      "method": "GET",
      "path_template": "/payments",
      "resource": "payment"
    },
    {
      "id": "create_refund",
      "method": "POST",
      "path_template": "/refunds",
      "resource": "payment",
      "body_template": {
        "payment_id": "{resource_id}",
        "amount": "{amount}"
      },
      "amount_field": "amount",
      "bound_source": {
        "route": "payment_detail",
        "field": "amount"
      },
      "accumulated_field": "refunded"
    }
  ]
}
