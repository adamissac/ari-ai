rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Notes are only read through the API (firebase-admin), never by clients.
    match /notes/{noteId} {
      allow read, write: if false;
    }
    // PLANTED DEFECT: "signed in" stands in for "is the owner".
    match /profiles/{uid} {
      allow read, write: if request.auth != null;
    }
  }
}
