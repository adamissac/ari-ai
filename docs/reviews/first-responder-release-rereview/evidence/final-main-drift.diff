+    key = "sk-ant-api03-" + "secretmarker" + "0" * 40
+    dsn = "post" + "gresql://svc_user" + ":" + "hunter2pass" + "@db.internal:5432/app"
+    kv = "pass" + "word=" + "hunter" + "2"
