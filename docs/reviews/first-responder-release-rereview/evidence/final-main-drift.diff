+    )
+    (path / "app/closers.py").write_text(f"def make():\n    return f(password={secret})\n")
+    (path / "app/still_code.py").write_text(
+        "def sig(secret: bytes, x: int) -> bool:\n"
+        "    return webhook_secret_configured and bool(secret)\n"
+    )
+    sha = commit(path)
