diff --git a/.github/workflows/security-agents.yml b/.github/workflows/security-agents.yml
index 65fa24ed..1ae9d434 100644
--- a/.github/workflows/security-agents.yml
+++ b/.github/workflows/security-agents.yml
@@ -3,31 +3,47 @@ name: security-agents
 # Pillar 2 runtime: the seven-agent suite (scripted FakeLLM, real tool registry,
 # scope_guard and local sandbox against the owned payments-lite target). Live
 # provider tests never run here.
+#
+# Release gate: runs on every PR and push to main so `secagents-tests` and
+# `docker-sandbox` always report; unrelated diffs are marked SKIPPED.
