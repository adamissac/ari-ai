+def register_retry_policy(kind: str, policy: RetryPolicy) -> None:
+    RETRY_POLICIES[kind] = policy
+
+
+def retry_policy_for(kind: str) -> RetryPolicy:
+    return RETRY_POLICIES.get(kind, DEFAULT_RETRY_POLICY)
