+class RetryPolicy:
+    """Exponential backoff with bounded positive jitter. Defaults keep the original
+    ``min(300, 2**attempts)`` curve; jitter spreads synchronized retries."""
+
+    base_s: float = 1.0
+    factor: float = 2.0
