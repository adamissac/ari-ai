{
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "pattern": "^art_[0-9A-Za-z_\\-]{8,64}$",
      "title": "Artifact Id",
      "type": "string"
    },
    "expectation_ids": {
      "items": {
        "pattern": "^exp_[0-9A-Za-z_\\-]{8,64}$",
        "type": "string"
      },
      "title": "Expectation Ids",
      "type": "array"
    },
    "id": {
      "pattern": "^tst_[0-9A-Za-z_\\-]{8,64}$",
      "title": "Id",
      "type": "string"
    },
    "outcome_on_head": {
      "description": "passed | failed | error, as executed",
      "maxLength": 500,
      "title": "Outcome On Head",
      "type": "string"
    },
    "path": {
      "maxLength": 1024,
      "minLength": 1,
      "title": "Path",
      "type": "string"
    }
  },
  "required": [
    "id",
    "path",
    "artifact_id",
    "outcome_on_head"
  ],
  "title": "GeneratedTest",
  "type": "object"
}
