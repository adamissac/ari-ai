{
  "additionalProperties": false,
  "properties": {
    "checkpoint_file": {
      "maxLength": 500,
      "title": "Checkpoint File",
      "type": "string"
    },
    "checkpoint_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Checkpoint Sha256",
      "type": "string"
    },
    "env_id": {
      "maxLength": 500,
      "title": "Env Id",
      "type": "string"
    },
    "git_sha": {
      "maxLength": 500,
      "title": "Git Sha",
      "type": "string"
    },
    "id": {
      "pattern": "^ckp_[0-9A-Za-z]{8,64}$",
      "title": "Id",
      "type": "string"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "steps": {
      "minimum": 0,
      "title": "Steps",
      "type": "integer"
    },
    "train_configs": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Train Configs",
      "type": "object"
    }
  },
  "required": [
    "id",
    "env_id",
    "seed",
    "steps",
    "git_sha",
    "checkpoint_file",
    "checkpoint_sha256"
  ],
  "title": "RLCheckpointRef",
  "type": "object"
}
