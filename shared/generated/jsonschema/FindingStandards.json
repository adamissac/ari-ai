{
  "$defs": {
    "BusinessPriority": {
      "enum": [
        "unset",
        "p1",
        "p2",
        "p3",
        "p4"
      ],
      "title": "BusinessPriority",
      "type": "string"
    },
    "CVSSAssessment": {
      "additionalProperties": false,
      "description": "A CVSS v4.0 base assessment. ``score`` is computed, never supplied by a model.",
      "properties": {
        "assessed_at": {
          "format": "date-time",
          "title": "Assessed At",
          "type": "string"
        },
        "assessor": {
          "description": "'system:standards.cvss_assess@<ver>' or 'user:<usr_id>'",
          "maxLength": 500,
          "title": "Assessor",
          "type": "string"
        },
        "assumptions": {
          "items": {
            "maxLength": 500,
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/CVSSMetricValue"
          },
          "title": "Metrics",
          "type": "array"
        },
        "missing_metrics": {
          "items": {
            "maxLength": 500,
            "type": "string"
          },
          "title": "Missing Metrics",
          "type": "array"
        },
        "nomenclature": {
          "anyOf": [
            {
              "enum": [
                "CVSS-B",
                "CVSS-BT",
                "CVSS-BE",
                "CVSS-BTE"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nomenclature"
        },
        "rationale": {
          "maxLength": 500,
          "title": "Rationale",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "scoring_engine": {
          "description": "Implementation and pinned reference version",
          "maxLength": 500,
          "title": "Scoring Engine",
          "type": "string"
        },
        "severity": {
          "anyOf": [
            {
              "enum": [
                "none",
                "low",
                "medium",
                "high",
                "critical"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Severity"
        },
        "vector": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Present only when complete",
          "title": "Vector"
        },
        "version": {
          "const": "4.0",
          "default": "4.0",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "complete",
        "rationale",
        "assessor",
        "scoring_engine",
        "assessed_at"
      ],
      "title": "CVSSAssessment",
      "type": "object"
    },
    "CVSSMetricBasis": {
      "enum": [
        "evidence",
        "rule",
        "assumption",
        "human"
      ],
      "title": "CVSSMetricBasis",
      "type": "string"
    },
    "CVSSMetricValue": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "$ref": "#/$defs/CVSSMetricBasis"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence",
          "type": "array"
        },
        "metric": {
          "enum": [
            "AV",
            "AC",
            "AT",
            "PR",
            "UI",
            "VC",
            "VI",
            "VA",
            "SC",
            "SI",
            "SA"
          ],
          "title": "Metric",
          "type": "string"
        },
        "rationale": {
          "maxLength": 500,
          "title": "Rationale",
          "type": "string"
        },
        "value": {
          "maxLength": 500,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "metric",
        "value",
        "basis",
        "rationale"
      ],
      "title": "CVSSMetricValue",
      "type": "object"
    },
    "CWEClassification": {
      "additionalProperties": false,
      "properties": {
        "catalog_status": {
          "$ref": "#/$defs/CatalogStatus",
          "default": "active"
        },
        "catalog_version": {
          "maxLength": 500,
          "title": "Catalog Version",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "framework": {
          "$ref": "#/$defs/StandardFramework"
        },
        "id": {
          "description": "Catalog identifier, e.g. T1190, D3-AMED, CWE-639, LLM01:2025",
          "maxLength": 500,
          "title": "Id",
          "type": "string"
        },
        "legacy": {
          "default": false,
          "description": "Imported under an older catalog release",
          "title": "Legacy",
          "type": "boolean"
        },
        "mapped_via": {
          "$ref": "#/$defs/MappedVia"
        },
        "mapping_usage": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "CWE's own Mapping_Notes/Usage for this entry (e.g. Allowed)",
          "title": "Mapping Usage"
        },
        "name": {
          "description": "Name from the catalog, never model text",
          "maxLength": 500,
          "title": "Name",
          "type": "string"
        },
        "observation": {
          "$ref": "#/$defs/Observation"
        },
        "rationale": {
          "maxLength": 500,
          "title": "Rationale",
          "type": "string"
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatus",
          "default": "proposed"
        },
        "reviewed_by": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed By"
        },
        "rule_id": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Rule-table row that produced it",
          "title": "Rule Id"
        },
        "url": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "framework",
        "id",
        "name",
        "catalog_version",
        "mapped_via",
        "observation",
        "rationale",
        "confidence",
        "evidence"
      ],
      "title": "CWEClassification",
      "type": "object"
    },
    "CatalogStatus": {
      "enum": [
        "active",
        "deprecated",
        "revoked"
      ],
      "title": "CatalogStatus",
      "type": "string"
    },
    "ControlStatus": {
      "enum": [
        "proposed",
        "implemented",
        "tested"
      ],
      "title": "ControlStatus",
      "type": "string"
    },
    "DefensiveMapping": {
      "additionalProperties": false,
      "properties": {
        "catalog_status": {
          "$ref": "#/$defs/CatalogStatus",
          "default": "active"
        },
        "catalog_version": {
          "maxLength": 500,
          "title": "Catalog Version",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "control_status": {
          "$ref": "#/$defs/ControlStatus",
          "default": "proposed"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "framework": {
          "$ref": "#/$defs/StandardFramework"
        },
        "hardening_id": {
          "anyOf": [
            {
              "pattern": "^hdn_[0-9A-Za-z_\\-]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hardening Id"
        },
        "id": {
          "description": "Catalog identifier, e.g. T1190, D3-AMED, CWE-639, LLM01:2025",
          "maxLength": 500,
          "title": "Id",
          "type": "string"
        },
        "legacy": {
          "default": false,
          "description": "Imported under an older catalog release",
          "title": "Legacy",
          "type": "boolean"
        },
        "mapped_via": {
          "$ref": "#/$defs/MappedVia"
        },
        "name": {
          "description": "Name from the catalog, never model text",
          "maxLength": 500,
          "title": "Name",
          "type": "string"
        },
        "observation": {
          "$ref": "#/$defs/Observation"
        },
        "rationale": {
          "maxLength": 500,
          "title": "Rationale",
          "type": "string"
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatus",
          "default": "proposed"
        },
        "reviewed_by": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed By"
        },
        "rule_id": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Rule-table row that produced it",
          "title": "Rule Id"
        },
        "simulation_derived": {
          "default": false,
          "title": "Simulation Derived",
          "type": "boolean"
        },
        "url": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "framework",
        "id",
        "name",
        "catalog_version",
        "mapped_via",
        "observation",
        "rationale",
        "confidence",
        "evidence"
      ],
      "title": "DefensiveMapping",
      "type": "object"
    },
    "EvidenceKind": {
      "enum": [
        "source_span",
        "test_run",
        "sandbox_run",
        "tool_output",
        "artifact",
        "human_input",
        "doc",
        "change_intent",
        "monitoring_event"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "description": "Pointer to a piece of evidence pinned to an exact code version.\n\n``source_span`` evidence must carry ``path`` + ``commit_sha`` + ``span``;\nartifact-backed kinds must carry ``artifact_id`` + ``sha256``.",
      "properties": {
        "artifact_id": {
          "anyOf": [
            {
              "pattern": "^art_[0-9A-Za-z_\\-]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Id"
        },
        "commit_sha": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit Sha"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "path": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "provenance": {
          "description": "Producer and version, e.g. 'code_intelligence.indexer@0.1' or 'agent:probe'",
          "maxLength": 500,
          "title": "Provenance",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceSpan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "symbol": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Qualified symbol name or sym_ id",
          "title": "Symbol"
        }
      },
      "required": [
        "kind",
        "provenance"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "ExploitStatus": {
      "enum": [
        "not_tested",
        "reproduced_in_sandbox",
        "not_reproduced"
      ],
      "title": "ExploitStatus",
      "type": "string"
    },
    "LegacyScore": {
      "additionalProperties": false,
      "description": "A score imported from elsewhere, kept verbatim with its scoring system and version.",
      "properties": {
        "imported_at": {
          "format": "date-time",
          "title": "Imported At",
          "type": "string"
        },
        "score": {
          "maximum": 10,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "source": {
          "maxLength": 500,
          "title": "Source",
          "type": "string"
        },
        "system": {
          "const": "cvss",
          "default": "cvss",
          "title": "System",
          "type": "string"
        },
        "vector": {
          "maxLength": 500,
          "title": "Vector",
          "type": "string"
        },
        "version": {
          "enum": [
            "2.0",
            "3.0",
            "3.1",
            "4.0"
          ],
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "vector",
        "score",
        "source",
        "imported_at"
      ],
      "title": "LegacyScore",
      "type": "object"
    },
    "MappedVia": {
      "description": "How a mapping was derived. Never ``model``: model proposals go through ``rule``/``human``.",
      "enum": [
        "check_template_rule",
        "catalog_relation",
        "reviewed_rule_table",
        "validated_proposal",
        "human"
      ],
      "title": "MappedVia",
      "type": "string"
    },
    "Observation": {
      "description": "What kind of evidence the mapping rests on.",
      "enum": [
        "observed_in_sandbox",
        "observed_runtime",
        "simulated",
        "hypothesis"
      ],
      "title": "Observation",
      "type": "string"
    },
    "ReviewStatus": {
      "enum": [
        "proposed",
        "accepted",
        "rejected"
      ],
      "title": "ReviewStatus",
      "type": "string"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "properties": {
        "end_col": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Col"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "start_col": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Col"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "start_line",
        "end_line"
      ],
      "title": "SourceSpan",
      "type": "object"
    },
    "StandardFramework": {
      "enum": [
        "attack",
        "d3fend",
        "cwe",
        "owasp_llm",
        "nist_csf"
      ],
      "title": "StandardFramework",
      "type": "string"
    },
    "StandardMapping": {
      "additionalProperties": false,
      "properties": {
        "catalog_status": {
          "$ref": "#/$defs/CatalogStatus",
          "default": "active"
        },
        "catalog_version": {
          "maxLength": 500,
          "title": "Catalog Version",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "framework": {
          "$ref": "#/$defs/StandardFramework"
        },
        "id": {
          "description": "Catalog identifier, e.g. T1190, D3-AMED, CWE-639, LLM01:2025",
          "maxLength": 500,
          "title": "Id",
          "type": "string"
        },
        "legacy": {
          "default": false,
          "description": "Imported under an older catalog release",
          "title": "Legacy",
          "type": "boolean"
        },
        "mapped_via": {
          "$ref": "#/$defs/MappedVia"
        },
        "name": {
          "description": "Name from the catalog, never model text",
          "maxLength": 500,
          "title": "Name",
          "type": "string"
        },
        "observation": {
          "$ref": "#/$defs/Observation"
        },
        "rationale": {
          "maxLength": 500,
          "title": "Rationale",
          "type": "string"
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatus",
          "default": "proposed"
        },
        "reviewed_by": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed By"
        },
        "rule_id": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Rule-table row that produced it",
          "title": "Rule Id"
        },
        "url": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "framework",
        "id",
        "name",
        "catalog_version",
        "mapped_via",
        "observation",
        "rationale",
        "confidence",
        "evidence"
      ],
      "title": "StandardMapping",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Standards view of one finding. Every entry carries its own catalog version and evidence.",
  "properties": {
    "attack": {
      "items": {
        "$ref": "#/$defs/StandardMapping"
      },
      "title": "Attack",
      "type": "array"
    },
    "business_priority": {
      "$ref": "#/$defs/BusinessPriority",
      "default": "unset",
      "description": "Set by a human; independent of CVSS"
    },
    "catalog_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Catalog Versions",
      "type": "object"
    },
    "classified_at": {
      "format": "date-time",
      "title": "Classified At",
      "type": "string"
    },
    "classified_by": {
      "maxLength": 500,
      "title": "Classified By",
      "type": "string"
    },
    "cvss": {
      "anyOf": [
        {
          "$ref": "#/$defs/CVSSAssessment"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "cwe": {
      "anyOf": [
        {
          "$ref": "#/$defs/CWEClassification"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "d3fend": {
      "items": {
        "$ref": "#/$defs/DefensiveMapping"
      },
      "title": "D3Fend",
      "type": "array"
    },
    "exploit_status": {
      "$ref": "#/$defs/ExploitStatus",
      "default": "not_tested"
    },
    "legacy_scores": {
      "items": {
        "$ref": "#/$defs/LegacyScore"
      },
      "title": "Legacy Scores",
      "type": "array"
    },
    "unmapped": {
      "description": "Why a framework was left unmapped (insufficient evidence, no catalog relation)",
      "items": {
        "maxLength": 500,
        "type": "string"
      },
      "title": "Unmapped",
      "type": "array"
    }
  },
  "required": [
    "classified_by",
    "classified_at"
  ],
  "title": "FindingStandards",
  "type": "object"
}
