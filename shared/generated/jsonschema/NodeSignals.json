{
  "additionalProperties": false,
  "description": "Observable per-node facts the platform can supply (no hidden attacker state).",
  "properties": {
    "alert_rate": {
      "default": 0.0,
      "minimum": 0.0,
      "title": "Alert Rate",
      "type": "number"
    },
    "anomaly_score": {
      "default": 0.0,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Anomaly Score",
      "type": "number"
    },
    "criticality": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Criticality",
      "type": "number"
    },
    "exposed": {
      "title": "Exposed",
      "type": "boolean"
    },
    "finding_severity": {
      "default": 0.0,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Finding Severity",
      "type": "number"
    },
    "isolated": {
      "default": false,
      "title": "Isolated",
      "type": "boolean"
    },
    "monitoring_level": {
      "default": 0,
      "minimum": 0,
      "title": "Monitoring Level",
      "type": "integer"
    },
    "node": {
      "enum": [
        "gateway",
        "api",
        "auth",
        "payments",
        "db"
      ],
      "title": "Node",
      "type": "string"
    },
    "rate_limited": {
      "default": false,
      "title": "Rate Limited",
      "type": "boolean"
    },
    "reassessment_pending": {
      "default": false,
      "title": "Reassessment Pending",
      "type": "boolean"
    }
