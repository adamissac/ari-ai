{
  "$defs": {
    "ReassessmentScope": {
      "enum": [
        "full",
        "targeted",
        "regression_only"
      ],
      "title": "ReassessmentScope",
      "type": "string"
    },
    "ReassessmentStatus": {
      "enum": [
        "queued",
        "coalesced",
        "started",
        "blocked_no_scope",
        "skipped"
      ],
      "title": "ReassessmentStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assessment_id": {
      "anyOf": [
        {
          "pattern": "^asm_[0-9A-Za-z]{8,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Assessment Id"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "event_ids": {
      "items": {
        "pattern": "^evt_[0-9A-Za-z]{8,64}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Event Ids",
      "type": "array"
    },
    "head_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Head Sha",
      "type": "string"
    },
    "id": {
      "pattern": "^rrq_[0-9A-Za-z]{8,64}$",
      "title": "Id",
      "type": "string"
    },
    "project_id": {
      "pattern": "^prj_[0-9A-Za-z]{8,64}$",
      "title": "Project Id",
      "type": "string"
    },
    "reason": {
      "maxLength": 500,
      "title": "Reason",
      "type": "string"
    },
    "repo_id": {
      "pattern": "^rep_[0-9A-Za-z]{8,64}$",
      "title": "Repo Id",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/ReassessmentScope"
    },
    "status": {
      "$ref": "#/$defs/ReassessmentStatus"
    },
    "targets": {
      "items": {
        "maxLength": 500,
        "type": "string"
      },
      "title": "Targets",
      "type": "array"
    }
  },
  "required": [
    "id",
    "project_id",
    "repo_id",
    "event_ids",
    "scope",
    "head_sha",
    "status",
    "reason",
    "created_at"
  ],
  "title": "ReassessmentRequest",
  "type": "object"
}
