{
  "$defs": {
    "AppEnvironment": {
      "enum": [
        "owned_test",
        "staging",
        "production"
      ],
      "title": "AppEnvironment",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "auto_response": {
      "default": false,
      "title": "Auto Response",
      "type": "boolean"
    },
    "control_url": {
      "description": "owner endpoint that applies controls",
      "maxLength": 500,
      "title": "Control Url",
      "type": "string"
    },
    "environment": {
      "$ref": "#/$defs/AppEnvironment"
    },
    "name": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "notify_url": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notify Url"
    },
    "protected_sources": {
      "items": {
        "type": "string"
      },
      "maxItems": 100,
      "title": "Protected Sources",
      "type": "array"
    }
  },
  "required": [
    "name",
    "environment",
    "control_url"
  ],
  "title": "ConnectedAppCreate",
  "type": "object"
}
