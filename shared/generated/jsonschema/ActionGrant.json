{
  "$defs": {
    "DefenseActionKind": {
      "enum": [
        "increase_logging",
        "rate_limit",
        "block_source",
        "escalate",
        "request_reassessment"
      ],
      "title": "DefenseActionKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "app_id": {
      "pattern": "^lap_[0-9A-Za-z_\\-]{8,64}$",
      "title": "App Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "granted_by": {
      "title": "Granted By",
      "type": "string"
    },
    "hourly_budget": {
      "title": "Hourly Budget",
      "type": "integer"
    },
    "id": {
      "pattern": "^lgr_[0-9A-Za-z_\\-]{8,64}$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/DefenseActionKind"
    },
    "max_duration_s": {
      "title": "Max Duration S",
      "type": "integer"
    },
    "revoked_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Revoked At"
    }
  },
  "required": [
    "id",
    "app_id",
    "kind",
    "max_duration_s",
    "hourly_budget",
    "granted_by",
    "created_at",
    "revoked_at"
  ],
  "title": "ActionGrant",
  "type": "object"
}
