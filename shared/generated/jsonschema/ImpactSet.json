{
  "$defs": {
    "ImpactResolution": {
      "enum": [
        "symbol",
        "path_only"
      ],
      "title": "ImpactResolution",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "What a commit range touches (docs/10 'Correlate').",
  "properties": {
    "base_sha": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Base Sha"
    },
    "base_snapshot_id": {
      "anyOf": [
        {
          "pattern": "^snp_[0-9A-Za-z]{8,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Base Snapshot Id"
    },
    "changed_paths": {
      "items": {
        "maxLength": 1024,
        "minLength": 1,
        "type": "string"
      },
      "title": "Changed Paths",
      "type": "array"
    },
    "expectations": {
      "items": {
        "pattern": "^exp_[0-9A-Za-z]{8,64}$",
        "type": "string"
      },
      "title": "Expectations",
      "type": "array"
    },
    "findings": {
      "items": {
        "pattern": "^fnd_[0-9A-Za-z]{8,64}$",
        "type": "string"
      },
      "title": "Findings",
      "type": "array"
    },
    "head_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Head Sha",
      "type": "string"
    },
    "head_snapshot_id": {
      "anyOf": [
        {
          "pattern": "^snp_[0-9A-Za-z]{8,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Head Snapshot Id"
    },
    "regression_tests": {
      "items": {
        "maxLength": 500,
        "type": "string"
      },
      "title": "Regression Tests",
      "type": "array"
    },
    "repo_id": {
      "pattern": "^rep_[0-9A-Za-z]{8,64}$",
      "title": "Repo Id",
      "type": "string"
    },
    "resolution": {
      "$ref": "#/$defs/ImpactResolution"
    },
    "symbols": {
      "items": {
        "pattern": "^sym_[0-9A-Za-z]{8,64}$",
        "type": "string"
      },
      "title": "Symbols",
      "type": "array"
    }
  },
  "required": [
    "repo_id",
    "head_sha",
    "resolution"
  ],
  "title": "ImpactSet",
  "type": "object"
}
