{
  "$defs": {
    "AttackPath": {
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "pattern": "^fnd_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Finding Id",
          "type": "string"
        },
        "id": {
          "pattern": "^atp_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Id",
          "type": "string"
        },
        "impact_summary": {
          "maxLength": 500,
          "title": "Impact Summary",
          "type": "string"
        },
        "preconditions": {
          "items": {
            "maxLength": 500,
            "type": "string"
          },
          "title": "Preconditions",
          "type": "array"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/PathStep"
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "id",
        "finding_id",
        "steps",
        "impact_summary"
      ],
      "title": "AttackPath",
      "type": "object"
    },
    "AttackPathEntry": {
      "additionalProperties": false,
      "properties": {
        "record": {
          "$ref": "#/$defs/AttackPath"
        },
        "type": {
          "const": "attack_path",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "record"
      ],
      "title": "AttackPathEntry",
      "type": "object"
    },
    "BusinessPriority": {
      "enum": [
        "unset",
        "p1",
        "p2",
        "p3",
        "p4"
      ],
      "title": "BusinessPriority",
      "type": "string"
    },
    "CVSSAssessment": {
      "additionalProperties": false,
      "description": "A CVSS v4.0 base assessment. ``score`` is computed, never supplied by a model.",
      "properties": {
        "assessed_at": {
          "format": "date-time",
          "title": "Assessed At",
          "type": "string"
        },
        "assessor": {
          "description": "'system:standards.cvss_assess@<ver>' or 'user:<usr_id>'",
          "maxLength": 500,
          "title": "Assessor",
          "type": "string"
        },
        "assumptions": {
          "items": {
            "maxLength": 500,
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/CVSSMetricValue"
          },
          "title": "Metrics",
          "type": "array"
        },
        "missing_metrics": {
          "items": {
            "maxLength": 500,
            "type": "string"
          },
          "title": "Missing Metrics",
          "type": "array"
        },
        "nomenclature": {
          "anyOf": [
            {
              "enum": [
                "CVSS-B",
                "CVSS-BT",
                "CVSS-BE",
                "CVSS-BTE"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nomenclature"
        },
        "rationale": {
          "maxLength": 500,
          "title": "Rationale",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "scoring_engine": {
          "description": "Implementation and pinned reference version",
          "maxLength": 500,
          "title": "Scoring Engine",
          "type": "string"
        },
        "severity": {
          "anyOf": [
            {
              "enum": [
                "none",
                "low",
                "medium",
                "high",
                "critical"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Severity"
        },
        "vector": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Present only when complete",
          "title": "Vector"
        },
        "version": {
          "const": "4.0",
          "default": "4.0",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "complete",
        "rationale",
        "assessor",
        "scoring_engine",
        "assessed_at"
      ],
      "title": "CVSSAssessment",
      "type": "object"
    },
    "CVSSMetricBasis": {
      "enum": [
        "evidence",
        "rule",
        "assumption",
        "human"
      ],
      "title": "CVSSMetricBasis",
      "type": "string"
    },
    "CVSSMetricValue": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "$ref": "#/$defs/CVSSMetricBasis"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence",
          "type": "array"
        },
        "metric": {
          "enum": [
            "AV",
            "AC",
            "AT",
            "PR",
            "UI",
            "VC",
            "VI",
            "VA",
            "SC",
            "SI",
            "SA"
          ],
          "title": "Metric",
          "type": "string"
        },
        "rationale": {
          "maxLength": 500,
          "title": "Rationale",
          "type": "string"
        },
        "value": {
          "maxLength": 500,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "metric",
        "value",
        "basis",
        "rationale"
      ],
      "title": "CVSSMetricValue",
      "type": "object"
    },
    "CWEClassification": {
      "additionalProperties": false,
      "properties": {
        "catalog_status": {
          "$ref": "#/$defs/CatalogStatus",
          "default": "active"
        },
        "catalog_version": {
          "maxLength": 500,
          "title": "Catalog Version",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "framework": {
          "$ref": "#/$defs/StandardFramework"
        },
        "id": {
          "description": "Catalog identifier, e.g. T1190, D3-AMED, CWE-639, LLM01:2025",
          "maxLength": 500,
          "title": "Id",
          "type": "string"
        },
        "legacy": {
          "default": false,
          "description": "Imported under an older catalog release",
          "title": "Legacy",
          "type": "boolean"
        },
        "mapped_via": {
          "$ref": "#/$defs/MappedVia"
        },
        "mapping_usage": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "CWE's own Mapping_Notes/Usage for this entry (e.g. Allowed)",
          "title": "Mapping Usage"
        },
        "name": {
          "description": "Name from the catalog, never model text",
          "maxLength": 500,
          "title": "Name",
          "type": "string"
        },
        "observation": {
          "$ref": "#/$defs/Observation"
        },
        "rationale": {
          "maxLength": 500,
          "title": "Rationale",
          "type": "string"
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatus",
          "default": "proposed"
        },
        "reviewed_by": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed By"
        },
        "rule_id": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Rule-table row that produced it",
          "title": "Rule Id"
        },
        "url": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "framework",
        "id",
        "name",
        "catalog_version",
        "mapped_via",
        "observation",
        "rationale",
        "confidence",
        "evidence"
      ],
      "title": "CWEClassification",
      "type": "object"
    },
    "CatalogStatus": {
      "enum": [
        "active",
        "deprecated",
        "revoked"
      ],
      "title": "CatalogStatus",
      "type": "string"
    },
    "ControlStatus": {
      "enum": [
        "proposed",
        "implemented",
        "tested"
      ],
      "title": "ControlStatus",
      "type": "string"
    },
    "DefensiveMapping": {
      "additionalProperties": false,
      "properties": {
        "catalog_status": {
          "$ref": "#/$defs/CatalogStatus",
          "default": "active"
        },
        "catalog_version": {
          "maxLength": 500,
          "title": "Catalog Version",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "control_status": {
          "$ref": "#/$defs/ControlStatus",
          "default": "proposed"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "framework": {
          "$ref": "#/$defs/StandardFramework"
        },
        "hardening_id": {
          "anyOf": [
            {
              "pattern": "^hdn_[0-9A-Za-z_\\-]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hardening Id"
        },
        "id": {
          "description": "Catalog identifier, e.g. T1190, D3-AMED, CWE-639, LLM01:2025",
          "maxLength": 500,
          "title": "Id",
          "type": "string"
        },
        "legacy": {
          "default": false,
          "description": "Imported under an older catalog release",
          "title": "Legacy",
          "type": "boolean"
        },
        "mapped_via": {
          "$ref": "#/$defs/MappedVia"
        },
        "name": {
          "description": "Name from the catalog, never model text",
          "maxLength": 500,
          "title": "Name",
          "type": "string"
        },
        "observation": {
          "$ref": "#/$defs/Observation"
        },
        "rationale": {
          "maxLength": 500,
          "title": "Rationale",
          "type": "string"
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatus",
          "default": "proposed"
        },
        "reviewed_by": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed By"
        },
        "rule_id": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Rule-table row that produced it",
          "title": "Rule Id"
        },
        "simulation_derived": {
          "default": false,
          "title": "Simulation Derived",
          "type": "boolean"
        },
        "url": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "framework",
        "id",
        "name",
        "catalog_version",
        "mapped_via",
        "observation",
        "rationale",
        "confidence",
        "evidence"
      ],
      "title": "DefensiveMapping",
      "type": "object"
    },
    "EvidenceKind": {
      "enum": [
        "source_span",
        "test_run",
        "sandbox_run",
        "tool_output",
        "artifact",
        "human_input",
        "doc",
        "change_intent",
        "monitoring_event"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "description": "Pointer to a piece of evidence pinned to an exact code version.\n\n``source_span`` evidence must carry ``path`` + ``commit_sha`` + ``span``;\nartifact-backed kinds must carry ``artifact_id`` + ``sha256``.",
      "properties": {
        "artifact_id": {
          "anyOf": [
            {
              "pattern": "^art_[0-9A-Za-z_\\-]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Id"
        },
        "commit_sha": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit Sha"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "path": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "provenance": {
          "description": "Producer and version, e.g. 'code_intelligence.indexer@0.1' or 'agent:probe'",
          "maxLength": 500,
          "title": "Provenance",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceSpan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "symbol": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Qualified symbol name or sym_ id",
          "title": "Symbol"
        }
      },
      "required": [
        "kind",
        "provenance"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "ExploitStatus": {
      "enum": [
        "not_tested",
        "reproduced_in_sandbox",
        "not_reproduced"
      ],
      "title": "ExploitStatus",
      "type": "string"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "assessment_id": {
          "pattern": "^asm_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Assessment Id",
          "type": "string"
        },
        "commit_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Commit Sha",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "expectation_ids": {
          "items": {
            "pattern": "^exp_[0-9A-Za-z_\\-]{8,64}$",
            "type": "string"
          },
          "title": "Expectation Ids",
          "type": "array"
        },
        "history": {
          "items": {
            "$ref": "#/$defs/StatusChange"
          },
          "title": "History",
          "type": "array"
        },
        "id": {
          "pattern": "^fnd_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/FindingKind"
        },
        "produced_by_run_id": {
          "anyOf": [
            {
              "pattern": "^run_[0-9A-Za-z_\\-]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Produced By Run Id"
        },
        "severity": {
          "anyOf": [
            {
              "$ref": "#/$defs/SeverityAssessment"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "snapshot_id": {
          "anyOf": [
            {
              "pattern": "^snp_[0-9A-Za-z_\\-]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snapshot Id"
        },
        "standards": {
          "anyOf": [
            {
              "$ref": "#/$defs/FindingStandards"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "0.7.0: CWE/ATT&CK/D3FEND/CVSS classification with evidence"
        },
        "status": {
          "$ref": "#/$defs/FindingStatus"
        },
        "subject_refs": {
          "items": {
            "maxLength": 500,
            "type": "string"
          },
          "title": "Subject Refs",
          "type": "array"
        },
        "title": {
          "maxLength": 500,
          "title": "Title",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "assessment_id",
        "commit_sha",
        "kind",
        "title",
        "status",
        "evidence",
        "confidence",
        "created_at",
        "updated_at"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FindingKind": {
      "enum": [
        "functional",
        "security"
      ],
      "title": "FindingKind",
      "type": "string"
    },
    "FindingStandards": {
      "additionalProperties": false,
      "description": "Standards view of one finding. Every entry carries its own catalog version and evidence.",
      "properties": {
        "attack": {
          "items": {
            "$ref": "#/$defs/StandardMapping"
          },
          "title": "Attack",
          "type": "array"
        },
        "business_priority": {
          "$ref": "#/$defs/BusinessPriority",
          "default": "unset",
          "description": "Set by a human; independent of CVSS"
        },
        "catalog_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Catalog Versions",
          "type": "object"
        },
        "classified_at": {
          "format": "date-time",
          "title": "Classified At",
          "type": "string"
        },
        "classified_by": {
          "maxLength": 500,
          "title": "Classified By",
          "type": "string"
        },
        "cvss": {
          "anyOf": [
            {
              "$ref": "#/$defs/CVSSAssessment"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cwe": {
          "anyOf": [
            {
              "$ref": "#/$defs/CWEClassification"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "d3fend": {
          "items": {
            "$ref": "#/$defs/DefensiveMapping"
          },
          "title": "D3Fend",
          "type": "array"
        },
        "exploit_status": {
          "$ref": "#/$defs/ExploitStatus",
          "default": "not_tested"
        },
        "legacy_scores": {
          "items": {
            "$ref": "#/$defs/LegacyScore"
          },
          "title": "Legacy Scores",
          "type": "array"
        },
        "unmapped": {
          "description": "Why a framework was left unmapped (insufficient evidence, no catalog relation)",
          "items": {
            "maxLength": 500,
            "type": "string"
          },
          "title": "Unmapped",
          "type": "array"
        }
      },
      "required": [
        "classified_by",
        "classified_at"
      ],
      "title": "FindingStandards",
      "type": "object"
    },
    "FindingStatus": {
      "enum": [
        "hypothesis",
        "validated",
        "refuted",
        "inconclusive",
        "diagnosed",
        "patch_proposed",
        "verified",
        "patch_rejected",
        "unresolved",
        "hardened",
        "accepted_risk",
        "closed",
        "needs_recheck"
      ],
      "title": "FindingStatus",
      "type": "string"
    },
    "HardeningEntry": {
      "additionalProperties": false,
      "properties": {
        "record": {
          "$ref": "#/$defs/HardeningRecommendation"
        },
        "type": {
          "const": "hardening",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "record"
      ],
      "title": "HardeningEntry",
      "type": "object"
    },
    "HardeningRecommendation": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "maxLength": 500,
          "title": "Category",
          "type": "string"
        },
        "d3fend": {
          "items": {
            "$ref": "#/$defs/DefensiveMapping"
          },
          "title": "D3Fend",
          "type": "array"
        },
        "effort": {
          "maxLength": 500,
          "title": "Effort",
          "type": "string"
        },
        "finding_id": {
          "pattern": "^fnd_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Finding Id",
          "type": "string"
        },
        "id": {
          "pattern": "^hdn_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Id",
          "type": "string"
        },
        "proposed_test_artifact_id": {
          "anyOf": [
            {
              "pattern": "^art_[0-9A-Za-z_\\-]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposed Test Artifact Id"
        },
        "recommendation": {
          "maxLength": 500,
          "title": "Recommendation",
          "type": "string"
        }
      },
      "required": [
        "id",
        "finding_id",
        "category",
        "recommendation",
        "effort"
