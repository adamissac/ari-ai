{
  "additionalProperties": false,
  "description": "Aggregated counters for one route over one window (no raw logs, no payloads).",
  "properties": {
    "auth_failures": {
      "default": 0,
      "description": "401/403 responses",
      "minimum": 0,
      "title": "Auth Failures",
      "type": "integer"
    },
    "requests": {
      "maximum": 10000000,
      "minimum": 0,
      "title": "Requests",
      "type": "integer"
    },
    "route": {
      "pattern": "^(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS) /[^\\s]{0,300}$",
      "title": "Route",
      "type": "string"
    },
    "status_4xx": {
      "default": 0,
      "minimum": 0,
      "title": "Status 4Xx",
      "type": "integer"
    },
    "status_5xx": {
      "default": 0,
      "minimum": 0,
      "title": "Status 5Xx",
      "type": "integer"
    }
  },
  "required": [
    "route",
    "requests"
  ],
  "title": "RouteWindow",
  "type": "object"
}
