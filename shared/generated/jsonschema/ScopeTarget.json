{
  "additionalProperties": false,
  "description": "MVP permits only targets built from the connected repo inside our sandbox.",
  "properties": {
    "build_recipe_ref": {
      "description": "e.g. examples/payments-lite/sandbox.yaml",
      "maxLength": 500,
      "title": "Build Recipe Ref",
      "type": "string"
    },
    "exposed_ports": {
      "items": {
        "type": "integer"
      },
      "maxItems": 8,
      "title": "Exposed Ports",
      "type": "array"
    },
    "kind": {
      "const": "sandbox_build",
      "default": "sandbox_build",
      "title": "Kind",
      "type": "string"
    },
    "repo_id": {
      "pattern": "^rep_[0-9A-Za-z_\\-]{8,64}$",
      "title": "Repo Id",
      "type": "string"
    }
  },
  "required": [
    "repo_id",
    "build_recipe_ref"
  ],
  "title": "ScopeTarget",
  "type": "object"
}
