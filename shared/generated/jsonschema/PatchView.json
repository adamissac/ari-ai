{
  "$defs": {
    "EvidenceKind": {
      "enum": [
        "source_span",
        "test_run",
        "sandbox_run",
        "tool_output",
        "artifact",
        "human_input",
        "doc",
        "change_intent",
        "monitoring_event"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "description": "Pointer to a piece of evidence pinned to an exact code version.\n\n``source_span`` evidence must carry ``path`` + ``commit_sha`` + ``span``;\nartifact-backed kinds must carry ``artifact_id`` + ``sha256``.",
      "properties": {
        "artifact_id": {
          "anyOf": [
            {
              "pattern": "^art_[0-9A-Za-z_\\-]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Id"
        },
        "commit_sha": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit Sha"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "path": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "provenance": {
          "description": "Producer and version, e.g. 'code_intelligence.indexer@0.1' or 'agent:probe'",
          "maxLength": 500,
          "title": "Provenance",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceSpan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "symbol": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Qualified symbol name or sym_ id",
          "title": "Symbol"
        }
      },
      "required": [
        "kind",
        "provenance"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "PatchCandidate": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "maximum": 5,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "base_commit_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Base Commit Sha",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "diff_artifact_id": {
          "pattern": "^art_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Diff Artifact Id",
          "type": "string"
        },
        "diff_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Diff Sha256",
          "type": "string"
        },
        "files_changed": {
          "items": {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Files Changed",
          "type": "array"
        },
        "finding_id": {
          "pattern": "^fnd_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Finding Id",
          "type": "string"
        },
        "id": {
          "pattern": "^pat_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Id",
          "type": "string"
        },
        "local_test_run_id": {
          "anyOf": [
            {
              "pattern": "^tst_[0-9A-Za-z_\\-]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Local Test Run Id"
        },
        "produced_by_run_id": {
          "pattern": "^run_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Produced By Run Id",
          "type": "string"
        },
        "rationale": {
          "maxLength": 500,
          "title": "Rationale",
          "type": "string"
        },
        "tests_added": {
          "items": {
            "maxLength": 500,
            "type": "string"
          },
          "title": "Tests Added",
          "type": "array"
        },
        "worktree_ref": {
          "maxLength": 500,
          "title": "Worktree Ref",
          "type": "string"
        }
      },
      "required": [
        "id",
        "finding_id",
        "attempt",
        "diff_artifact_id",
        "diff_sha256",
        "base_commit_sha",
        "worktree_ref",
        "files_changed",
        "produced_by_run_id",
        "rationale",
        "created_at"
      ],
      "title": "PatchCandidate",
      "type": "object"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "properties": {
        "end_col": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Col"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "start_col": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Col"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "start_line",
        "end_line"
      ],
      "title": "SourceSpan",
      "type": "object"
    },
    "VerificationCheck": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "name": {
          "$ref": "#/$defs/VerificationCheckName"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "passed",
        "evidence"
      ],
      "title": "VerificationCheck",
      "type": "object"
    },
    "VerificationCheckName": {
      "enum": [
        "original_check_now_fails_to_reproduce",
        "functional_suite_passes",
        "generated_tests_pass",
        "no_test_tampering",
        "diff_scope_ok"
      ],
      "title": "VerificationCheckName",
      "type": "string"
    },
    "VerificationResult": {
      "additionalProperties": false,
      "description": "Independent Verify verdict. ``accepted`` requires every check to pass.",
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/VerificationCheck"
          },
          "minItems": 1,
          "title": "Checks",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "id": {
          "pattern": "^ver_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Id",
          "type": "string"
        },
        "patch_id": {
          "pattern": "^pat_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Patch Id",
          "type": "string"
        },
        "produced_by_run_id": {
          "pattern": "^run_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Produced By Run Id",
          "type": "string"
        },
        "reasons": {
          "items": {
            "maxLength": 500,
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "sandbox_run_ids": {
          "items": {
            "maxLength": 500,
            "type": "string"
          },
          "minItems": 1,
          "title": "Sandbox Run Ids",
          "type": "array"
        },
        "verdict": {
          "$ref": "#/$defs/VerificationVerdict"
        }
      },
      "required": [
        "id",
        "patch_id",
        "verdict",
        "checks",
        "sandbox_run_ids",
        "produced_by_run_id",
        "created_at"
      ],
      "title": "VerificationResult",
      "type": "object"
    },
    "VerificationVerdict": {
      "enum": [
        "accepted",
        "rejected"
      ],
      "title": "VerificationVerdict",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "patch": {
      "$ref": "#/$defs/PatchCandidate"
    },
    "verification": {
      "anyOf": [
        {
          "$ref": "#/$defs/VerificationResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "patch"
  ],
  "title": "PatchView",
  "type": "object"
}
