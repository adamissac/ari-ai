{
  "$defs": {
    "CVSSAssessment": {
      "additionalProperties": false,
      "description": "A CVSS v4.0 base assessment. ``score`` is computed, never supplied by a model.",
      "properties": {
        "assessed_at": {
          "format": "date-time",
          "title": "Assessed At",
          "type": "string"
        },
        "assessor": {
          "description": "'system:standards.cvss_assess@<ver>' or 'user:<usr_id>'",
          "maxLength": 500,
          "title": "Assessor",
          "type": "string"
        },
        "assumptions": {
          "items": {
            "maxLength": 500,
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/CVSSMetricValue"
          },
          "title": "Metrics",
          "type": "array"
        },
        "missing_metrics": {
          "items": {
            "maxLength": 500,
            "type": "string"
          },
          "title": "Missing Metrics",
          "type": "array"
        },
        "nomenclature": {
          "anyOf": [
            {
              "enum": [
                "CVSS-B",
                "CVSS-BT",
                "CVSS-BE",
                "CVSS-BTE"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nomenclature"
        },
        "rationale": {
          "maxLength": 500,
          "title": "Rationale",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "scoring_engine": {
          "description": "Implementation and pinned reference version",
          "maxLength": 500,
          "title": "Scoring Engine",
          "type": "string"
        },
        "severity": {
          "anyOf": [
            {
              "enum": [
                "none",
                "low",
                "medium",
                "high",
                "critical"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Severity"
        },
        "vector": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Present only when complete",
          "title": "Vector"
        },
        "version": {
          "const": "4.0",
          "default": "4.0",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "complete",
        "rationale",
        "assessor",
        "scoring_engine",
        "assessed_at"
      ],
      "title": "CVSSAssessment",
      "type": "object"
    },
    "CVSSMetricBasis": {
      "enum": [
        "evidence",
        "rule",
        "assumption",
        "human"
      ],
      "title": "CVSSMetricBasis",
      "type": "string"
    },
    "CVSSMetricValue": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "$ref": "#/$defs/CVSSMetricBasis"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence",
          "type": "array"
        },
        "metric": {
          "enum": [
            "AV",
            "AC",
            "AT",
            "PR",
            "UI",
            "VC",
            "VI",
            "VA",
            "SC",
            "SI",
            "SA"
          ],
          "title": "Metric",
          "type": "string"
        },
        "rationale": {
          "maxLength": 500,
          "title": "Rationale",
          "type": "string"
        },
        "value": {
          "maxLength": 500,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "metric",
        "value",
        "basis",
        "rationale"
      ],
      "title": "CVSSMetricValue",
      "type": "object"
    },
    "EvidenceKind": {
      "enum": [
        "source_span",
        "test_run",
        "sandbox_run",
        "tool_output",
        "artifact",
        "human_input",
        "doc",
        "change_intent",
        "monitoring_event"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "description": "Pointer to a piece of evidence pinned to an exact code version.\n\n``source_span`` evidence must carry ``path`` + ``commit_sha`` + ``span``;\nartifact-backed kinds must carry ``artifact_id`` + ``sha256``.",
      "properties": {
        "artifact_id": {
          "anyOf": [
            {
              "pattern": "^art_[0-9A-Za-z_\\-]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Id"
        },
        "commit_sha": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit Sha"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "path": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "provenance": {
          "description": "Producer and version, e.g. 'code_intelligence.indexer@0.1' or 'agent:probe'",
          "maxLength": 500,
          "title": "Provenance",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceSpan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "symbol": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Qualified symbol name or sym_ id",
          "title": "Symbol"
        }
      },
      "required": [
        "kind",
        "provenance"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "SeverityFactors": {
      "additionalProperties": false,
      "properties": {
        "data_sensitivity": {
          "maxLength": 500,
          "title": "Data Sensitivity",
          "type": "string"
        },
        "privileges_required": {
          "maxLength": 500,
          "title": "Privileges Required",
          "type": "string"
        },
        "reachability": {
          "maxLength": 500,
          "title": "Reachability",
          "type": "string"
        },
        "verified_path": {
          "title": "Verified Path",
          "type": "boolean"
        }
      },
      "required": [
        "reachability",
        "privileges_required",
        "data_sensitivity",
        "verified_path"
      ],
      "title": "SeverityFactors",
      "type": "object"
    },
    "SeverityLevel": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "SeverityLevel",
      "type": "string"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "properties": {
        "end_col": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Col"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "start_col": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Col"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "start_line",
        "end_line"
      ],
      "title": "SourceSpan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cvss": {
      "anyOf": [
        {
          "$ref": "#/$defs/CVSSAssessment"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "factors": {
      "$ref": "#/$defs/SeverityFactors"
    },
    "level": {
      "$ref": "#/$defs/SeverityLevel"
    },
    "rationale": {
      "maxLength": 500,
      "title": "Rationale",
      "type": "string"
    }
  },
  "required": [
    "level",
    "factors",
    "rationale"
  ],
  "title": "SeverityAssessment",
  "type": "object"
}
