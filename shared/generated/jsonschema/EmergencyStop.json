{
  "additionalProperties": false,
  "properties": {
    "active": {
      "title": "Active",
      "type": "boolean"
    },
    "application_id": {
      "anyOf": [
        {
          "pattern": "^app_[0-9A-Za-z_\\-]{8,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Application Id"
    },
    "cleared_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cleared At"
    },
    "id": {
      "pattern": "^est_[0-9A-Za-z_\\-]{8,64}$",
      "title": "Id",
      "type": "string"
    },
    "note": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Note"
    },
    "project_id": {
      "pattern": "^prj_[0-9A-Za-z_\\-]{8,64}$",
      "title": "Project Id",
      "type": "string"
    },
    "requested_at": {
      "format": "date-time",
      "title": "Requested At",
      "type": "string"
    },
    "requested_by": {
      "pattern": "^usr_[0-9A-Za-z_\\-]{8,64}$",
      "title": "Requested By",
      "type": "string"
    },
    "verified_cleared": {
      "default": false,
      "title": "Verified Cleared",
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "project_id",
    "active",
    "requested_by",
    "requested_at"
  ],
  "title": "EmergencyStop",
  "type": "object"
}
