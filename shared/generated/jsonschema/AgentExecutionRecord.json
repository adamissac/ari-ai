{
  "$defs": {
    "ExecutionIntegrity": {
      "description": "Whether typed output cited real snapshot spans. Not threat confirmation.",
      "enum": [
        "not_run",
        "checked",
        "failed"
      ],
      "title": "ExecutionIntegrity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Genuine agent-loop outcome for future RL research. Not a confirmed threat.",
  "properties": {
    "confirmation": {
      "const": "unverified",
      "default": "unverified",
      "title": "Confirmation",
      "type": "string"
    },
    "cost_usd": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cost Usd"
    },
    "ended_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ended At"
    },
    "error_code": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "evidence_verified": {
      "const": false,
      "default": false,
      "title": "Evidence Verified",
      "type": "boolean"
    },
    "execution_integrity": {
      "$ref": "#/$defs/ExecutionIntegrity",
      "default": "not_run"
    },
    "hypothesis_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Hypothesis Count"
    },
    "independent_verification_id": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Independent Verification Id"
    },
    "latency_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latency Ms"
    },
    "llm_turns": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Llm Turns"
    },
    "model_id": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Id"
    },
    "output_artifact_id": {
      "anyOf": [
        {
          "pattern": "^art_[0-9A-Za-z_\\-]{8,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Artifact Id"
    },
    "predicted_probability": {
      "default": null,
      "title": "Predicted Probability",
      "type": "null"
    },
    "provider_mode": {
      "default": "none",
      "enum": [
        "fake",
        "live",
        "none"
      ],
      "title": "Provider Mode",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "tool_call_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tool Call Count"
    },
    "transcript_artifact_id": {
      "anyOf": [
        {
          "pattern": "^art_[0-9A-Za-z_\\-]{8,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Transcript Artifact Id"
    },
    "typed_output": {
      "default": false,
      "title": "Typed Output",
      "type": "boolean"
    }
  },
  "title": "AgentExecutionRecord",
  "type": "object"
}
