{
  "$defs": {
    "ApprovalGate": {
      "enum": [
        "containment",
        "eradication",
        "recovery",
        "closure"
      ],
      "title": "ApprovalGate",
      "type": "string"
    },
    "EvidenceKind": {
      "enum": [
        "source_span",
        "test_run",
        "sandbox_run",
        "tool_output",
        "artifact",
        "human_input",
        "doc",
        "change_intent",
        "monitoring_event"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "description": "Pointer to a piece of evidence pinned to an exact code version.\n\n``source_span`` evidence must carry ``path`` + ``commit_sha`` + ``span``;\nartifact-backed kinds must carry ``artifact_id`` + ``sha256``.",
      "properties": {
        "artifact_id": {
          "anyOf": [
            {
              "pattern": "^art_[0-9A-Za-z_\\-]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Id"
        },
        "commit_sha": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit Sha"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "path": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "provenance": {
          "description": "Producer and version, e.g. 'code_intelligence.indexer@0.1' or 'agent:probe'",
          "maxLength": 500,
          "title": "Provenance",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceSpan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "symbol": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Qualified symbol name or sym_ id",
          "title": "Symbol"
        }
      },
      "required": [
        "kind",
        "provenance"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "IncidentActionKind": {
      "enum": [
        "triage",
        "assign_owner",
        "escalate",
        "transition",
        "request_approval",
        "decide_approval",
        "link",
        "record_communication",
        "add_closure_criterion",
        "satisfy_closure_criterion",
        "record_lessons_learned"
      ],
      "title": "IncidentActionKind",
      "type": "string"
    },
    "IncidentState": {
      "enum": [
        "reported",
        "triaged",
        "analysis",
        "containment",
        "eradication",
        "recovery",
        "closed",
        "rejected"
      ],
      "title": "IncidentState",
      "type": "string"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "properties": {
        "end_col": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Col"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "start_col": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Col"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "start_line",
        "end_line"
      ],
      "title": "SourceSpan",
      "type": "object"
    },
    "TriageDecisionKind": {
      "enum": [
        "confirmed_incident",
        "not_an_incident",
        "duplicate"
      ],
      "title": "TriageDecisionKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One API action on an incident. Fields not relevant to ``kind`` must be left unset.",
  "properties": {
    "action_summary": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Action Summary"
    },
    "approve": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approve"
    },
    "audience": {
      "anyOf": [
        {
          "enum": [
            "internal",
            "external",
            "customer",
            "regulator",
            "law_enforcement"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Audience"
    },
    "business_priority": {
      "anyOf": [
        {
          "enum": [
            "unset",
            "p1",
            "p2",
            "p3",
            "p4"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Business Priority"
    },
    "category": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Category"
    },
    "channel": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Channel"
    },
    "criterion_key": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Criterion Key"
    },
    "csf_ref": {
      "anyOf": [
        {
          "enum": [
            "RS.CO-02",
            "RS.CO-03",
            "RC.CO-03"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Csf Ref"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Evidence",
      "type": "array"
    },
    "finding_ids": {
      "items": {
        "pattern": "^fnd_[0-9A-Za-z_\\-]{8,64}$",
        "type": "string"
      },
      "title": "Finding Ids",
      "type": "array"
    },
    "gate": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApprovalGate"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "kind": {
      "$ref": "#/$defs/IncidentActionKind"
    },
    "monitoring_event_ids": {
      "items": {
        "pattern": "^evt_[0-9A-Za-z_\\-]{8,64}$",
        "type": "string"
      },
      "title": "Monitoring Event Ids",
      "type": "array"
    },
    "note": {
      "default": "",
      "maxLength": 500,
      "title": "Note",
      "type": "string"
    },
    "owner": {
      "anyOf": [
        {
          "pattern": "^usr_[0-9A-Za-z_\\-]{8,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Owner"
    },
    "recommendation_ids": {
      "items": {
        "pattern": "^rec_[0-9A-Za-z_\\-]{8,64}$",
        "type": "string"
      },
      "title": "Recommendation Ids",
      "type": "array"
    },
    "target_state": {
      "anyOf": [
        {
          "$ref": "#/$defs/IncidentState"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "triage_decision": {
      "anyOf": [
        {
          "$ref": "#/$defs/TriageDecisionKind"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "verification_ids": {
      "items": {
        "pattern": "^ver_[0-9A-Za-z_\\-]{8,64}$",
        "type": "string"
      },
      "title": "Verification Ids",
      "type": "array"
    }
  },
  "required": [
    "kind"
  ],
  "title": "IncidentAction",
  "type": "object"
}
