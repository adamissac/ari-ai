{
  "$defs": {
    "SymbolKind": {
      "enum": [
        "module",
        "class",
        "function",
        "method"
      ],
      "title": "SymbolKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "decorators": {
      "items": {
        "maxLength": 500,
        "type": "string"
      },
      "title": "Decorators",
      "type": "array"
    },
    "docstring": {
      "anyOf": [
        {
          "maxLength": 20000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Docstring"
    },
    "end_line": {
      "minimum": 1,
      "title": "End Line",
      "type": "integer"
    },
    "id": {
      "pattern": "^sym_[0-9A-Za-z_\\-]{8,64}$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/SymbolKind"
    },
    "path": {
      "maxLength": 1024,
      "minLength": 1,
      "title": "Path",
      "type": "string"
    },
    "qualified_name": {
      "maxLength": 500,
      "title": "Qualified Name",
      "type": "string"
    },
    "signature": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Signature"
    },
    "snapshot_id": {
      "pattern": "^snp_[0-9A-Za-z_\\-]{8,64}$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "start_line": {
      "minimum": 1,
      "title": "Start Line",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "snapshot_id",
    "kind",
    "qualified_name",
    "path",
    "start_line",
    "end_line"
  ],
  "title": "Symbol",
  "type": "object"
}
