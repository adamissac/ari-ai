{
  "$defs": {
    "SnapshotStats": {
      "additionalProperties": false,
      "properties": {
        "call_edges": {
          "default": 0,
          "minimum": 0,
          "title": "Call Edges",
          "type": "integer"
        },
        "entry_points": {
          "default": 0,
          "minimum": 0,
          "title": "Entry Points",
          "type": "integer"
        },
        "expectations": {
          "default": 0,
          "minimum": 0,
          "title": "Expectations",
          "type": "integer"
        },
        "files": {
          "default": 0,
          "minimum": 0,
          "title": "Files",
          "type": "integer"
        },
        "symbols": {
          "default": 0,
          "minimum": 0,
          "title": "Symbols",
          "type": "integer"
        }
      },
      "title": "SnapshotStats",
      "type": "object"
    },
    "SnapshotStatus": {
      "enum": [
        "pending",
        "indexing",
        "ready",
        "failed"
      ],
      "title": "SnapshotStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "base_snapshot_id": {
      "anyOf": [
        {
          "pattern": "^snp_[0-9A-Za-z_\\-]{8,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Base Snapshot Id"
    },
    "commit_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Commit Sha",
      "type": "string"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "error_message": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Message"
    },
    "id": {
      "pattern": "^snp_[0-9A-Za-z_\\-]{8,64}$",
      "title": "Id",
      "type": "string"
    },
    "index_version": {
      "maxLength": 500,
      "title": "Index Version",
      "type": "string"
    },
    "repo_id": {
      "pattern": "^rep_[0-9A-Za-z_\\-]{8,64}$",
      "title": "Repo Id",
      "type": "string"
    },
    "stats": {
      "$ref": "#/$defs/SnapshotStats"
    },
    "status": {
      "$ref": "#/$defs/SnapshotStatus"
    }
  },
  "required": [
    "id",
    "repo_id",
    "commit_sha",
    "status",
    "index_version",
    "created_at"
  ],
  "title": "Snapshot",
  "type": "object"
}
