{
  "$defs": {
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "max_tokens": {
          "default": 400000,
          "minimum": 0,
          "title": "Max Tokens",
          "type": "integer"
        },
        "max_usd": {
          "default": 10.0,
          "minimum": 0,
          "title": "Max Usd",
          "type": "number"
        },
        "max_wall_clock_s": {
          "default": 1800,
          "minimum": 1,
          "title": "Max Wall Clock S",
          "type": "integer"
        }
      },
      "title": "Budget",
      "type": "object"
    },
    "DeliveryMode": {
      "description": "How verified repairs reach the repository (ADR-0020).",
      "enum": [
        "auto",
        "pull_request",
        "manual"
      ],
      "title": "DeliveryMode",
      "type": "string"
    },
    "TriggerPolicy": {
      "additionalProperties": false,
      "description": "Monitoring trigger policy (docs/10). Defaults match the MVP table.",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "ignore_paths_only": {
          "description": "If every changed path matches these globs, record without assessment",
          "items": {
            "maxLength": 500,
            "type": "string"
          },
          "title": "Ignore Paths Only",
          "type": "array"
        },
        "min_interval_s": {
          "default": 600,
          "description": "Coalescing window per repo",
          "minimum": 0,
          "title": "Min Interval S",
          "type": "integer"
        },
        "monitoring_budget": {
          "$ref": "#/$defs/Budget",
          "description": "Budget for one push-triggered monitoring run (smaller than default_budget by design)"
        }
      },
      "title": "TriggerPolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "default_budget": {
      "$ref": "#/$defs/Budget"
    },
    "delivery_authorized_by": {
      "anyOf": [
        {
          "pattern": "^usr_[0-9A-Za-z_\\-]{8,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Owner on whose standing authorization Ari approves and delivers fixes; set by the server, never the client. Null on projects that predate delivery modes: they stay manual until an owner saves settings.",
      "title": "Delivery Authorized By"
    },
    "delivery_mode": {
      "$ref": "#/$defs/DeliveryMode",
      "default": "auto"
    },
    "languages": {
      "items": {
        "maxLength": 500,
        "type": "string"
      },
      "title": "Languages",
      "type": "array"
    },
    "monitoring_policy": {
      "$ref": "#/$defs/TriggerPolicy"
    }
  },
  "title": "ProjectSettings",
  "type": "object"
}
