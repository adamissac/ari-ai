{
  "$defs": {
    "ScopeStatus": {
      "enum": [
        "pending",
        "active",
        "expired",
        "revoked"
      ],
      "title": "ScopeStatus",
      "type": "string"
    },
    "ScopeTarget": {
      "additionalProperties": false,
      "description": "MVP permits only targets built from the connected repo inside our sandbox.",
      "properties": {
        "build_recipe_ref": {
          "description": "e.g. examples/payments-lite/sandbox.yaml",
          "maxLength": 500,
          "title": "Build Recipe Ref",
          "type": "string"
        },
        "exposed_ports": {
          "items": {
            "type": "integer"
          },
          "maxItems": 8,
          "title": "Exposed Ports",
          "type": "array"
        },
        "kind": {
          "const": "sandbox_build",
          "default": "sandbox_build",
          "title": "Kind",
          "type": "string"
        },
        "repo_id": {
          "pattern": "^rep_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Repo Id",
          "type": "string"
        }
      },
      "required": [
        "repo_id",
        "build_recipe_ref"
      ],
      "title": "ScopeTarget",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "allowed_check_categories": {
      "items": {
        "maxLength": 500,
        "type": "string"
      },
      "title": "Allowed Check Categories",
      "type": "array"
    },
    "approved_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approved At"
    },
    "approved_by": {
      "anyOf": [
        {
          "pattern": "^usr_[0-9A-Za-z_\\-]{8,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approved By"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "id": {
      "pattern": "^scp_[0-9A-Za-z_\\-]{8,64}$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "maxLength": 500,
      "title": "Name",
      "type": "string"
    },
    "notes": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    },
    "project_id": {
      "pattern": "^prj_[0-9A-Za-z_\\-]{8,64}$",
      "title": "Project Id",
      "type": "string"
    },
    "requested_by": {
      "pattern": "^usr_[0-9A-Za-z_\\-]{8,64}$",
      "title": "Requested By",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ScopeStatus"
    },
    "targets": {
      "items": {
        "$ref": "#/$defs/ScopeTarget"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Targets",
      "type": "array"
    }
  },
  "required": [
    "id",
    "project_id",
    "name",
    "targets",
    "status",
    "requested_by",
    "expires_at"
  ],
  "title": "AuthorizedScope",
  "type": "object"
}
