{
  "$defs": {
    "AgentName": {
      "enum": [
        "scout",
        "probe",
        "trace",
        "diagnose",
        "patch",
        "fortify",
        "verify",
        "reviewer"
      ],
      "title": "AgentName",
      "type": "string"
    },
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "max_tokens": {
          "default": 400000,
          "minimum": 0,
          "title": "Max Tokens",
          "type": "integer"
        },
        "max_usd": {
          "default": 10.0,
          "minimum": 0,
          "title": "Max Usd",
          "type": "number"
        },
        "max_wall_clock_s": {
          "default": 1800,
          "minimum": 1,
          "title": "Max Wall Clock S",
          "type": "integer"
        }
      },
      "title": "Budget",
      "type": "object"
    },
    "SnapshotRef": {
      "additionalProperties": false,
      "properties": {
        "commit_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Commit Sha",
          "type": "string"
        },
        "index_version": {
          "maxLength": 500,
          "title": "Index Version",
          "type": "string"
        },
        "project_id": {
          "pattern": "^prj_[0-9A-Za-z]{8,64}$",
          "title": "Project Id",
          "type": "string"
        },
        "repo_id": {
          "pattern": "^rep_[0-9A-Za-z]{8,64}$",
          "title": "Repo Id",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^snp_[0-9A-Za-z]{8,64}$",
          "title": "Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "repo_id",
        "commit_sha",
        "snapshot_id",
        "index_version"
      ],
      "title": "SnapshotRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "What the orchestrator hands an agent runner for one step.",
  "properties": {
    "agent": {
      "$ref": "#/$defs/AgentName"
    },
    "assessment_id": {
      "pattern": "^asm_[0-9A-Za-z]{8,64}$",
      "title": "Assessment Id",
      "type": "string"
    },
    "attempt": {
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "budget": {
      "$ref": "#/$defs/Budget"
    },
    "context_pack_id": {
      "anyOf": [
        {
          "pattern": "^ctx_[0-9A-Za-z]{8,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Context Pack Id"
    },
    "payload": {
      "additionalProperties": true,
      "description": "Role-specific typed input (security_agents defines per-role models)",
      "title": "Payload",
      "type": "object"
    },
    "scope_id": {
      "pattern": "^scp_[0-9A-Za-z]{8,64}$",
      "title": "Scope Id",
      "type": "string"
    },
    "snapshot_ref": {
      "$ref": "#/$defs/SnapshotRef"
    },
    "step_key": {
      "maxLength": 500,
      "title": "Step Key",
      "type": "string"
    }
  },
  "required": [
    "assessment_id",
    "agent",
    "step_key",
    "attempt",
    "snapshot_ref",
    "scope_id",
    "budget"
  ],
  "title": "AgentStepInput",
  "type": "object"
}
