{
  "$defs": {
    "EntryPointKind": {
      "enum": [
        "http_route",
        "cli",
        "job"
      ],
      "title": "EntryPointKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "auth_dependencies": {
      "items": {
        "maxLength": 500,
        "type": "string"
      },
      "title": "Auth Dependencies",
      "type": "array"
    },
    "handler_symbol_id": {
      "pattern": "^sym_[0-9A-Za-z]{8,64}$",
      "title": "Handler Symbol Id",
      "type": "string"
    },
    "id": {
      "pattern": "^ent_[0-9A-Za-z]{8,64}$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/EntryPointKind"
    },
    "method": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Method"
    },
    "path_template": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Path Template"
    },
    "snapshot_id": {
      "pattern": "^snp_[0-9A-Za-z]{8,64}$",
      "title": "Snapshot Id",
      "type": "string"
    }
  },
  "required": [
    "id",
    "snapshot_id",
    "kind",
    "handler_symbol_id"
  ],
  "title": "EntryPoint",
  "type": "object"
}
