{
  "additionalProperties": false,
  "properties": {
    "attempt": {
      "maximum": 5,
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "base_commit_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Base Commit Sha",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "diff_artifact_id": {
      "pattern": "^art_[0-9A-Za-z_\\-]{8,64}$",
      "title": "Diff Artifact Id",
      "type": "string"
    },
    "diff_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Diff Sha256",
      "type": "string"
    },
    "files_changed": {
      "items": {
        "maxLength": 1024,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Files Changed",
      "type": "array"
    },
    "finding_id": {
      "pattern": "^fnd_[0-9A-Za-z_\\-]{8,64}$",
      "title": "Finding Id",
      "type": "string"
    },
    "id": {
      "pattern": "^pat_[0-9A-Za-z_\\-]{8,64}$",
      "title": "Id",
      "type": "string"
    },
    "local_test_run_id": {
      "anyOf": [
        {
          "pattern": "^tst_[0-9A-Za-z_\\-]{8,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Local Test Run Id"
    },
    "produced_by_run_id": {
      "pattern": "^run_[0-9A-Za-z_\\-]{8,64}$",
      "title": "Produced By Run Id",
      "type": "string"
    },
    "rationale": {
      "maxLength": 500,
      "title": "Rationale",
      "type": "string"
    },
    "tests_added": {
      "items": {
        "maxLength": 500,
        "type": "string"
      },
      "title": "Tests Added",
      "type": "array"
    },
    "worktree_ref": {
      "maxLength": 500,
      "title": "Worktree Ref",
      "type": "string"
    }
  },
  "required": [
    "id",
    "finding_id",
    "attempt",
    "diff_artifact_id",
    "diff_sha256",
    "base_commit_sha",
    "worktree_ref",
    "files_changed",
    "produced_by_run_id",
    "rationale",
    "created_at"
  ],
  "title": "PatchCandidate",
  "type": "object"
}
