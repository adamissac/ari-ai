{
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "display_name": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Display Name"
    },
    "github_login": {
      "maxLength": 500,
      "title": "Github Login",
      "type": "string"
    },
    "id": {
      "pattern": "^usr_[0-9A-Za-z_\\-]{8,64}$",
      "title": "Id",
      "type": "string"
    }
  },
  "required": [
    "id",
    "github_login",
    "created_at"
  ],
  "title": "User",
  "type": "object"
}
