{
  "$defs": {
    "AssessmentState": {
      "enum": [
        "CREATED",
        "SCOPE_CHECK",
        "INDEXING",
        "FUNCTIONAL_REVIEW",
        "RECON",
        "VALIDATION",
        "ANALYSIS",
        "DIAGNOSIS",
        "AWAITING_APPROVAL",
        "REMEDIATION",
        "HARDENING",
        "REPORTING",
        "COMPLETED",
        "FAILED",
        "CANCELLED",
        "BUDGET_EXHAUSTED"
      ],
      "title": "AssessmentState",
      "type": "string"
    },
    "AssessmentTrigger": {
      "enum": [
        "manual",
        "monitoring"
      ],
      "title": "AssessmentTrigger",
      "type": "string"
    },
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "max_tokens": {
          "default": 400000,
          "minimum": 0,
          "title": "Max Tokens",
          "type": "integer"
        },
        "max_usd": {
          "default": 10.0,
          "minimum": 0,
          "title": "Max Usd",
          "type": "number"
        },
        "max_wall_clock_s": {
          "default": 1800,
          "minimum": 1,
          "title": "Max Wall Clock S",
          "type": "integer"
        }
      },
      "title": "Budget",
      "type": "object"
    },
    "ErrorBody": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "message": {
          "maxLength": 500,
          "title": "Message",
          "type": "string"
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorBody",
      "type": "object"
    },
    "ErrorCode": {
      "enum": [
        "SCOPE_DENIED",
        "APPROVAL_REQUIRED",
        "BUDGET_EXHAUSTED",
        "SCHEMA_INVALID",
        "SANDBOX_START_FAILED",
        "SANDBOX_TIMEOUT",
        "SANDBOX_POLICY_VIOLATION",
        "TOOL_NOT_ALLOWED",
        "SNAPSHOT_NOT_READY",
        "WEBHOOK_SIGNATURE_INVALID",
        "LLM_UNAVAILABLE",
        "CONFLICT_STATE",
        "LLM_REFUSAL",
        "LLM_OUTPUT_TRUNCATED",
        "UNAUTHENTICATED",
        "FORBIDDEN",
        "CSRF_FAILED",
        "NOT_FOUND",
        "VALIDATION_FAILED",
        "RATE_LIMITED",
        "PAYLOAD_TOO_LARGE",
        "IDEMPOTENCY_CONFLICT",
        "SUBSYSTEM_UNAVAILABLE",
        "CANCELLED",
        "JOB_LEASE_EXPIRED",
        "INTERNAL",
        "KILL_SWITCH"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "cache_read_input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Cache Read Input Tokens",
          "type": "integer"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "llm_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Llm Calls",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "sandbox_seconds": {
          "default": 0.0,
          "minimum": 0,
          "title": "Sandbox Seconds",
          "type": "number"
        },
        "tool_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Tool Calls",
          "type": "integer"
        },
        "usd": {
          "default": 0.0,
          "minimum": 0,
          "title": "Usd",
          "type": "number"
        }
      },
      "title": "Usage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "budget": {
      "$ref": "#/$defs/Budget"
    },
    "commit_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Commit Sha",
      "type": "string"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "anyOf": [
        {
          "pattern": "^usr_[0-9A-Za-z_\\-]{8,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "None for monitoring triggers",
      "title": "Created By"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorBody"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "id": {
      "pattern": "^asm_[0-9A-Za-z_\\-]{8,64}$",
      "title": "Id",
      "type": "string"
    },
    "project_id": {
      "pattern": "^prj_[0-9A-Za-z_\\-]{8,64}$",
      "title": "Project Id",
      "type": "string"
    },
    "reassessment_request_id": {
      "anyOf": [
        {
          "pattern": "^rrq_[0-9A-Za-z_\\-]{8,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reassessment Request Id"
    },
    "repo_id": {
      "anyOf": [
        {
          "pattern": "^rep_[0-9A-Za-z_\\-]{8,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The one repository this assessment ran on (always set by the backend); findings link source lines to it, so multi-repository scopes need no guessing",
      "title": "Repo Id"
    },
    "scope_id": {
      "pattern": "^scp_[0-9A-Za-z_\\-]{8,64}$",
      "title": "Scope Id",
      "type": "string"
    },
    "snapshot_id": {
      "anyOf": [
        {
          "pattern": "^snp_[0-9A-Za-z_\\-]{8,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Set once the commit is indexed; commit_sha is always set",
      "title": "Snapshot Id"
    },
    "state": {
      "$ref": "#/$defs/AssessmentState"
    },
    "trigger": {
      "$ref": "#/$defs/AssessmentTrigger"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "usage": {
      "$ref": "#/$defs/Usage"
    }
  },
  "required": [
    "id",
    "project_id",
    "commit_sha",
    "scope_id",
    "trigger",
    "state",
    "budget",
    "created_at",
    "updated_at"
  ],
  "title": "Assessment",
  "type": "object"
}
