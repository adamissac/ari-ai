{
  "additionalProperties": false,
  "properties": {
    "commit_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Commit Sha",
      "type": "string"
    },
    "index_version": {
      "maxLength": 500,
      "title": "Index Version",
      "type": "string"
    },
    "project_id": {
      "pattern": "^prj_[0-9A-Za-z]{8,64}$",
      "title": "Project Id",
      "type": "string"
    },
    "repo_id": {
      "pattern": "^rep_[0-9A-Za-z]{8,64}$",
      "title": "Repo Id",
      "type": "string"
    },
    "snapshot_id": {
      "pattern": "^snp_[0-9A-Za-z]{8,64}$",
      "title": "Snapshot Id",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "repo_id",
    "commit_sha",
    "snapshot_id",
    "index_version"
  ],
  "title": "SnapshotRef",
  "type": "object"
}
