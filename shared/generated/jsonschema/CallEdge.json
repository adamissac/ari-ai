{
  "$defs": {
    "CallResolution": {
      "enum": [
        "exact",
        "likely",
        "unresolved"
      ],
      "title": "CallResolution",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "callee_id": {
      "anyOf": [
        {
          "pattern": "^sym_[0-9A-Za-z]{8,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Callee Id"
    },
    "callee_name": {
      "maxLength": 500,
      "title": "Callee Name",
      "type": "string"
    },
    "caller_id": {
      "pattern": "^sym_[0-9A-Za-z]{8,64}$",
      "title": "Caller Id",
      "type": "string"
    },
    "resolution": {
      "$ref": "#/$defs/CallResolution"
    },
    "snapshot_id": {
      "pattern": "^snp_[0-9A-Za-z]{8,64}$",
      "title": "Snapshot Id",
      "type": "string"
    }
  },
  "required": [
    "snapshot_id",
    "caller_id",
    "callee_name",
    "resolution"
  ],
  "title": "CallEdge",
  "type": "object"
}
