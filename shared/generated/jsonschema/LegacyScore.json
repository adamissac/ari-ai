{
  "additionalProperties": false,
  "description": "A score imported from elsewhere, kept verbatim with its scoring system and version.",
  "properties": {
    "imported_at": {
      "format": "date-time",
      "title": "Imported At",
      "type": "string"
    },
    "score": {
      "maximum": 10,
      "minimum": 0,
      "title": "Score",
      "type": "number"
    },
    "source": {
      "maxLength": 500,
      "title": "Source",
      "type": "string"
    },
    "system": {
      "const": "cvss",
      "default": "cvss",
      "title": "System",
      "type": "string"
    },
    "vector": {
      "maxLength": 500,
      "title": "Vector",
      "type": "string"
    },
    "version": {
      "enum": [
        "2.0",
        "3.0",
        "3.1",
        "4.0"
      ],
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "version",
    "vector",
    "score",
    "source",
    "imported_at"
  ],
  "title": "LegacyScore",
  "type": "object"
}
