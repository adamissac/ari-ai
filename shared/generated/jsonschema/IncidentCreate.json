      },
      "title": "Monitoring Event Ids",
      "type": "array"
    },
    "note": {
      "default": "",
      "maxLength": 500,
      "title": "Note",
      "type": "string"
    },
    "recommendation_ids": {
      "items": {
        "pattern": "^rec_[0-9A-Za-z_\\-]{8,64}$",
