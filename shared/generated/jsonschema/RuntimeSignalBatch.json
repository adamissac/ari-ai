{
  "$defs": {
    "RouteWindow": {
      "additionalProperties": false,
      "description": "Aggregated counters for one route over one window (no raw logs, no payloads).",
      "properties": {
        "auth_failures": {
          "default": 0,
          "description": "401/403 responses",
          "minimum": 0,
          "title": "Auth Failures",
          "type": "integer"
        },
        "requests": {
          "maximum": 10000000,
          "minimum": 0,
          "title": "Requests",
          "type": "integer"
        },
        "route": {
          "pattern": "^(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS) /[^\\s]{0,300}$",
          "title": "Route",
          "type": "string"
        },
        "status_4xx": {
          "default": 0,
          "minimum": 0,
          "title": "Status 4Xx",
          "type": "integer"
        },
        "status_5xx": {
          "default": 0,
          "minimum": 0,
          "title": "Status 5Xx",
          "type": "integer"
        }
      },
      "required": [
        "route",
        "requests"
      ],
      "title": "RouteWindow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "repo_id": {
      "anyOf": [
        {
          "pattern": "^rep_[0-9A-Za-z_\\-]{8,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Repo Id"
    },
    "routes": {
      "items": {
        "$ref": "#/$defs/RouteWindow"
      },
      "maxItems": 500,
      "minItems": 1,
      "title": "Routes",
      "type": "array"
    },
    "source": {
      "enum": [
        "runtime_demo",
        "replay",
        "simulated"
      ],
      "title": "Source",
      "type": "string"
    },
    "window_end": {
      "format": "date-time",
      "title": "Window End",
      "type": "string"
    },
    "window_start": {
      "format": "date-time",
      "title": "Window Start",
      "type": "string"
    }
  },
  "required": [
    "source",
    "window_start",
    "window_end",
    "routes"
  ],
  "title": "RuntimeSignalBatch",
  "type": "object"
}
