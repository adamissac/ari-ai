{
  "$defs": {
    "FindingStatus": {
      "enum": [
        "hypothesis",
        "validated",
        "refuted",
        "inconclusive",
        "diagnosed",
        "patch_proposed",
        "verified",
        "patch_rejected",
        "unresolved",
        "hardened",
        "accepted_risk",
        "closed",
        "needs_recheck"
      ],
      "title": "FindingStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actor": {
      "description": "'agent:<name>', 'user:<usr_id>' or 'system'",
      "maxLength": 500,
      "title": "Actor",
      "type": "string"
    },
    "at": {
      "format": "date-time",
      "title": "At",
      "type": "string"
    },
    "from_status": {
      "anyOf": [
        {
          "$ref": "#/$defs/FindingStatus"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "to_status": {
      "$ref": "#/$defs/FindingStatus"
    }
  },
  "required": [
    "from_status",
    "to_status",
    "at",
    "actor"
  ],
  "title": "StatusChange",
  "type": "object"
}
