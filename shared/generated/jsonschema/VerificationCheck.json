{
  "$defs": {
    "EvidenceKind": {
      "enum": [
        "source_span",
        "test_run",
        "sandbox_run",
        "tool_output",
        "artifact",
        "human_input",
        "doc",
        "change_intent",
        "monitoring_event"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "description": "Pointer to a piece of evidence pinned to an exact code version.\n\n``source_span`` evidence must carry ``path`` + ``commit_sha`` + ``span``;\nartifact-backed kinds must carry ``artifact_id`` + ``sha256``.",
      "properties": {
        "artifact_id": {
          "anyOf": [
            {
              "pattern": "^art_[0-9A-Za-z]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Id"
        },
        "commit_sha": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit Sha"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "path": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "provenance": {
          "description": "Producer and version, e.g. 'code_intelligence.indexer@0.1' or 'agent:probe'",
          "maxLength": 500,
          "title": "Provenance",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceSpan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "symbol": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Qualified symbol name or sym_ id",
          "title": "Symbol"
        }
      },
      "required": [
        "kind",
        "provenance"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "properties": {
        "end_col": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Col"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "start_col": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Col"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "start_line",
        "end_line"
      ],
      "title": "SourceSpan",
      "type": "object"
    },
    "VerificationCheckName": {
      "enum": [
        "original_check_now_fails_to_reproduce",
        "functional_suite_passes",
        "generated_tests_pass",
        "no_test_tampering",
        "diff_scope_ok"
      ],
      "title": "VerificationCheckName",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "name": {
      "$ref": "#/$defs/VerificationCheckName"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    }
  },
  "required": [
    "name",
    "passed",
    "evidence"
  ],
  "title": "VerificationCheck",
  "type": "object"
}
