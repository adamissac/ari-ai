{
  "$defs": {
    "ApprovalStatus": {
      "enum": [
        "pending",
        "approved",
        "declined"
      ],
      "title": "ApprovalStatus",
      "type": "string"
    },
    "ApprovalSubject": {
      "enum": [
        "scope",
        "remediation",
        "pr"
      ],
      "title": "ApprovalSubject",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "decided_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decided At"
    },
    "decided_by": {
      "anyOf": [
        {
          "pattern": "^usr_[0-9A-Za-z]{8,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decided By"
    },
    "id": {
      "pattern": "^apv_[0-9A-Za-z]{8,64}$",
      "title": "Id",
      "type": "string"
    },
    "project_id": {
      "pattern": "^prj_[0-9A-Za-z]{8,64}$",
      "title": "Project Id",
      "type": "string"
    },
    "reason": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "requested_at": {
      "format": "date-time",
      "title": "Requested At",
      "type": "string"
    },
    "requested_by": {
      "anyOf": [
        {
          "pattern": "^usr_[0-9A-Za-z]{8,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "None when requested by system",
      "title": "Requested By"
    },
    "status": {
      "$ref": "#/$defs/ApprovalStatus"
    },
    "subject_id": {
      "maxLength": 500,
      "title": "Subject Id",
      "type": "string"
    },
    "subject_type": {
      "$ref": "#/$defs/ApprovalSubject"
    }
  },
  "required": [
    "id",
    "project_id",
    "subject_type",
    "subject_id",
    "status",
    "requested_at"
  ],
  "title": "Approval",
  "type": "object"
}
