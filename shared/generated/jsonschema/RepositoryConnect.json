{
  "additionalProperties": false,
  "properties": {
    "default_branch": {
      "default": "main",
      "maxLength": 500,
      "title": "Default Branch",
      "type": "string"
    },
    "full_name": {
      "pattern": "^[A-Za-z0-9_.\\-]+/[A-Za-z0-9_.\\-]+$",
      "title": "Full Name",
      "type": "string"
    },
    "installation_id": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Installation Id"
    }
  },
  "required": [
    "full_name"
  ],
  "title": "RepositoryConnect",
  "type": "object"
}
