{
  "$defs": {
    "ErrorCode": {
      "enum": [
        "SCOPE_DENIED",
        "APPROVAL_REQUIRED",
        "BUDGET_EXHAUSTED",
        "SCHEMA_INVALID",
        "SANDBOX_START_FAILED",
        "SANDBOX_TIMEOUT",
        "SANDBOX_POLICY_VIOLATION",
        "TOOL_NOT_ALLOWED",
        "SNAPSHOT_NOT_READY",
        "WEBHOOK_SIGNATURE_INVALID",
        "LLM_UNAVAILABLE",
        "CONFLICT_STATE",
        "LLM_REFUSAL",
        "LLM_OUTPUT_TRUNCATED",
        "UNAUTHENTICATED",
        "FORBIDDEN",
        "CSRF_FAILED",
        "NOT_FOUND",
        "VALIDATION_FAILED",
        "RATE_LIMITED",
        "PAYLOAD_TOO_LARGE",
        "IDEMPOTENCY_CONFLICT",
        "SUBSYSTEM_UNAVAILABLE",
        "CANCELLED",
        "JOB_LEASE_EXPIRED",
        "INTERNAL",
        "KILL_SWITCH"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "ToolCallOutcome": {
      "enum": [
        "ok",
        "error",
        "denied"
      ],
      "title": "ToolCallOutcome",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One tool invocation requested by an agent, as enforced by the tool registry.",
  "properties": {
    "duration_ms": {
      "minimum": 0,
      "title": "Duration Ms",
      "type": "integer"
    },
    "error_code": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorCode"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "outcome": {
      "$ref": "#/$defs/ToolCallOutcome"
    },
    "output_artifact_id": {
      "anyOf": [
        {
          "pattern": "^art_[0-9A-Za-z_\\-]{8,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Artifact Id"
    },
    "tool_name": {
      "maxLength": 500,
      "title": "Tool Name",
      "type": "string"
    },
    "turn": {
      "minimum": 0,
      "title": "Turn",
      "type": "integer"
    }
  },
  "required": [
    "turn",
    "tool_name",
    "input_sha256",
    "outcome",
    "duration_ms"
  ],
  "title": "ToolCallRecord",
  "type": "object"
}
