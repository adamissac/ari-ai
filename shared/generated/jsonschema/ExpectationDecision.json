{
  "$defs": {
    "SnapshotRef": {
      "additionalProperties": false,
      "properties": {
        "commit_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Commit Sha",
          "type": "string"
        },
        "index_version": {
          "maxLength": 500,
          "title": "Index Version",
          "type": "string"
        },
        "project_id": {
          "pattern": "^prj_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Project Id",
          "type": "string"
        },
        "repo_id": {
          "pattern": "^rep_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Repo Id",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^snp_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "repo_id",
        "commit_sha",
        "snapshot_id",
        "index_version"
      ],
      "title": "SnapshotRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "decided_at": {
      "format": "date-time",
      "title": "Decided At",
      "type": "string"
    },
    "decided_by": {
      "pattern": "^usr_[0-9A-Za-z_\\-]{8,64}$",
      "title": "Decided By",
      "type": "string"
    },
    "expectation_id": {
      "pattern": "^exp_[0-9A-Za-z_\\-]{8,64}$",
      "title": "Expectation Id",
      "type": "string"
    },
    "expected_revision": {
      "minimum": 0,
      "title": "Expected Revision",
      "type": "integer"
    },
    "reason": {
      "maxLength": 500,
      "minLength": 3,
      "title": "Reason",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "snapshot_ref": {
      "$ref": "#/$defs/SnapshotRef"
    },
    "status": {
      "enum": [
        "confirmed",
        "conflicting",
        "rejected"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "status",
    "reason",
    "expected_revision",
    "snapshot_ref",
    "expectation_id",
    "revision",
    "decided_by",
    "decided_at"
  ],
  "title": "ExpectationDecision",
  "type": "object"
}
