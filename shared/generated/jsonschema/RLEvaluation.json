{
  "additionalProperties": false,
  "description": "Pointer to a persisted protocol-17 ``eval_summary.json`` (stored verbatim as artifact).",
  "properties": {
    "checkpoint_ids": {
      "items": {
        "pattern": "^ckp_[0-9A-Za-z_\\-]{8,64}$",
        "type": "string"
      },
      "title": "Checkpoint Ids",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "id": {
      "pattern": "^rle_[0-9A-Za-z_\\-]{8,64}$",
      "title": "Id",
      "type": "string"
    },
    "protocol_version": {
      "maxLength": 500,
      "title": "Protocol Version",
      "type": "string"
    },
    "simulation_derived": {
      "const": true,
      "default": true,
      "title": "Simulation Derived",
      "type": "boolean"
    },
    "summary_artifact_id": {
      "pattern": "^art_[0-9A-Za-z_\\-]{8,64}$",
      "title": "Summary Artifact Id",
      "type": "string"
    },
    "summary_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Summary Sha256",
      "type": "string"
    }
  },
  "required": [
    "id",
    "protocol_version",
    "summary_artifact_id",
    "summary_sha256",
    "created_at"
  ],
  "title": "RLEvaluation",
  "type": "object"
}
