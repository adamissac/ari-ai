{
  "$defs": {
    "AgentName": {
      "enum": [
        "scout",
        "probe",
        "trace",
        "diagnose",
        "patch",
        "fortify",
        "verify",
        "reviewer"
      ],
      "title": "AgentName",
      "type": "string"
    },
    "AssessmentState": {
      "enum": [
        "CREATED",
        "SCOPE_CHECK",
        "INDEXING",
        "FUNCTIONAL_REVIEW",
        "RECON",
        "VALIDATION",
        "ANALYSIS",
        "DIAGNOSIS",
        "AWAITING_APPROVAL",
        "REMEDIATION",
        "HARDENING",
        "REPORTING",
        "COMPLETED",
        "FAILED",
        "CANCELLED",
        "BUDGET_EXHAUSTED"
      ],
      "title": "AssessmentState",
      "type": "string"
    },
    "StreamEventType": {
      "enum": [
        "assessment.state_changed",
        "assessment.progress",
        "agent_run.started",
        "agent_run.finished",
        "finding.updated",
        "approval.requested",
        "assessment.completed",
        "assessment.failed"
      ],
      "title": "StreamEventType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentName"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "agent_run_id": {
      "anyOf": [
        {
          "pattern": "^run_[0-9A-Za-z_\\-]{8,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agent Run Id"
    },
    "approval_id": {
      "anyOf": [
        {
          "pattern": "^apv_[0-9A-Za-z_\\-]{8,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approval Id"
    },
    "assessment_id": {
      "pattern": "^asm_[0-9A-Za-z_\\-]{8,64}$",
      "title": "Assessment Id",
      "type": "string"
    },
    "at": {
      "format": "date-time",
      "title": "At",
      "type": "string"
    },
    "data": {
      "additionalProperties": true,
      "title": "Data",
      "type": "object"
    },
    "finding_id": {
      "anyOf": [
        {
          "pattern": "^fnd_[0-9A-Za-z_\\-]{8,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finding Id"
    },
    "message": {
      "maxLength": 500,
      "title": "Message",
      "type": "string"
    },
    "seq": {
      "minimum": 1,
      "title": "Seq",
      "type": "integer"
    },
    "state": {
      "anyOf": [
        {
          "$ref": "#/$defs/AssessmentState"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "type": {
      "$ref": "#/$defs/StreamEventType"
    }
  },
  "required": [
    "seq",
    "assessment_id",
    "type",
    "message",
    "at"
  ],
  "title": "StreamEvent",
  "type": "object"
}
