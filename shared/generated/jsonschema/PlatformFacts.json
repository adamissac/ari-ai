{
  "$defs": {
    "NodeSignals": {
      "additionalProperties": false,
      "description": "Observable per-node facts the platform can supply (no hidden attacker state).",
      "properties": {
        "alert_rate": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Alert Rate",
          "type": "number"
        },
        "anomaly_score": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Anomaly Score",
          "type": "number"
        },
        "criticality": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Criticality",
          "type": "number"
        },
        "exposed": {
          "title": "Exposed",
          "type": "boolean"
        },
        "finding_severity": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Finding Severity",
          "type": "number"
        },
        "isolated": {
          "default": false,
          "title": "Isolated",
          "type": "boolean"
        },
        "monitoring_level": {
          "default": 0,
          "minimum": 0,
          "title": "Monitoring Level",
          "type": "integer"
        },
        "node": {
          "enum": [
            "gateway",
            "api",
            "auth",
            "payments",
            "db"
          ],
          "title": "Node",
          "type": "string"
        },
        "rate_limited": {
          "default": false,
          "title": "Rate Limited",
          "type": "boolean"
        },
        "reassessment_pending": {
          "default": false,
          "title": "Reassessment Pending",
          "type": "boolean"
        }
      },
      "required": [
        "node",
        "criticality",
        "exposed"
      ],
      "title": "NodeSignals",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "escalation_pending": {
      "default": false,
      "title": "Escalation Pending",
      "type": "boolean"
    },
    "escalations_remaining_fraction": {
      "default": 1.0,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Escalations Remaining Fraction",
      "type": "number"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/NodeSignals"
      },
      "maxItems": 5,
      "minItems": 5,
      "title": "Nodes",
      "type": "array"
    },
    "project_id": {
      "anyOf": [
        {
          "pattern": "^prj_[0-9A-Za-z_\\-]{8,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Id"
    },
    "time_fraction": {
      "default": 0.0,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Time Fraction",
      "type": "number"
    }
  },
  "required": [
    "nodes"
  ],
  "title": "PlatformFacts",
  "type": "object"
}
