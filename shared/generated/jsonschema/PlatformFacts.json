{
  "$defs": {
    "NodeSignals": {
      "additionalProperties": false,
      "description": "Observable per-node facts the platform can supply (no hidden attacker state).",
      "properties": {
        "alert_rate": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Alert Rate",
          "type": "number"
        },
        "anomaly_score": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Anomaly Score",
          "type": "number"
        },
        "criticality": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Criticality",
          "type": "number"
        },
        "exposed": {
          "title": "Exposed",
          "type": "boolean"
        },
        "finding_severity": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Finding Severity",
          "type": "number"
        },
        "isolated": {
          "default": false,
          "title": "Isolated",
          "type": "boolean"
        },
        "monitoring_level": {
          "default": 0,
          "minimum": 0,
          "title": "Monitoring Level",
          "type": "integer"
        },
        "node": {
          "enum": [
            "gateway",
            "api",
            "auth",
            "payments",
            "db"
          ],
          "title": "Node",
          "type": "string"
        },
        "rate_limited": {
          "default": false,
          "title": "Rate Limited",
          "type": "boolean"
        },
        "reassessment_pending": {
          "default": false,
          "title": "Reassessment Pending",
          "type": "boolean"
        }
      },
      "required": [
        "node",
        "criticality",
        "exposed"
      ],
      "title": "NodeSignals",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "block_remaining": {
      "default": 0.0,
      "description": "longest remaining block / long duration",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Block Remaining",
      "type": "number"
    },
    "escalation_pending": {
      "default": false,
      "title": "Escalation Pending",
      "type": "boolean"
    },
    "escalations_remaining_fraction": {
      "default": 1.0,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Escalations Remaining Fraction",
      "type": "number"
    },
    "flagged_own_share": {
      "default": 0.0,
      "description": "share of flagged principals' requests that read their own tenant",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Flagged Own Share",
      "type": "number"
    },
    "flagged_principals": {
      "default": 0.0,
      "description": "distinct flagged principals / 3 (capped)",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Flagged Principals",
      "type": "number"
    },
    "flagged_repeat": {
      "default": 0.0,
      "description": "share of flagged principals blocked before",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Flagged Repeat",
      "type": "number"
    },
    "flagged_top_share": {
      "default": 0.0,
      "description": "heaviest flagged principal's share of flagged cross-tenant attempts",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Flagged Top Share",
      "type": "number"
    },
    "flagged_volume": {
      "default": 0.0,
      "description": "cross-tenant attempts per flagged principal / 6 (capped)",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Flagged Volume",
      "type": "number"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/NodeSignals"
      },
      "maxItems": 5,
      "minItems": 5,
      "title": "Nodes",
      "type": "array"
    },
    "principal_block_active": {
      "default": false,
      "description": "a block_principal control is currently in force",
      "title": "Principal Block Active",
      "type": "boolean"
    },
    "principal_block_available": {
      "default": false,
      "description": "the detector flagged a principal that is not yet blocked where it was seen",
      "title": "Principal Block Available",
      "type": "boolean"
    },
    "principal_block_long_available": {
      "default": false,
      "description": "some flagged principal is unblocked or its block is about to lapse",
      "title": "Principal Block Long Available",
      "type": "boolean"
    },
    "principal_block_top_long_available": {
      "default": false,
      "description": "the same, for the most active flagged principal(s)",
      "title": "Principal Block Top Long Available",
      "type": "boolean"
    },
    "project_id": {
      "anyOf": [
        {
          "pattern": "^prj_[0-9A-Za-z_\\-]{8,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Id"
    },
    "time_fraction": {
      "default": 0.0,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Time Fraction",
      "type": "number"
    }
  },
  "required": [
    "nodes"
  ],
  "title": "PlatformFacts",
  "type": "object"
}
