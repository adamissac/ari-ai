{
  "$defs": {
    "EvidenceKind": {
      "enum": [
        "source_span",
        "test_run",
        "sandbox_run",
        "tool_output",
        "artifact",
        "human_input",
        "doc",
        "change_intent",
        "monitoring_event"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "description": "Pointer to a piece of evidence pinned to an exact code version.\n\n``source_span`` evidence must carry ``path`` + ``commit_sha`` + ``span``;\nartifact-backed kinds must carry ``artifact_id`` + ``sha256``.",
      "properties": {
        "artifact_id": {
          "anyOf": [
            {
              "pattern": "^art_[0-9A-Za-z_\\-]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Id"
        },
        "commit_sha": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit Sha"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "path": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "provenance": {
          "description": "Producer and version, e.g. 'code_intelligence.indexer@0.1' or 'agent:probe'",
          "maxLength": 500,
          "title": "Provenance",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceSpan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "symbol": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Qualified symbol name or sym_ id",
          "title": "Symbol"
        }
      },
      "required": [
        "kind",
        "provenance"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "FindingKind": {
      "enum": [
        "functional",
        "security"
      ],
      "title": "FindingKind",
      "type": "string"
    },
    "FindingStatus": {
      "enum": [
        "hypothesis",
        "validated",
        "refuted",
        "inconclusive",
        "diagnosed",
        "patch_proposed",
        "verified",
        "patch_rejected",
        "unresolved",
        "hardened",
        "accepted_risk",
        "closed",
        "needs_recheck"
      ],
      "title": "FindingStatus",
      "type": "string"
    },
    "SeverityAssessment": {
      "additionalProperties": false,
      "properties": {
        "factors": {
          "$ref": "#/$defs/SeverityFactors"
        },
        "level": {
          "$ref": "#/$defs/SeverityLevel"
        },
        "rationale": {
          "maxLength": 500,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "level",
        "factors",
        "rationale"
      ],
      "title": "SeverityAssessment",
      "type": "object"
    },
    "SeverityFactors": {
      "additionalProperties": false,
      "properties": {
        "data_sensitivity": {
          "maxLength": 500,
          "title": "Data Sensitivity",
          "type": "string"
        },
        "privileges_required": {
          "maxLength": 500,
          "title": "Privileges Required",
          "type": "string"
        },
        "reachability": {
          "maxLength": 500,
          "title": "Reachability",
          "type": "string"
        },
        "verified_path": {
          "title": "Verified Path",
          "type": "boolean"
        }
      },
      "required": [
        "reachability",
        "privileges_required",
        "data_sensitivity",
        "verified_path"
      ],
      "title": "SeverityFactors",
      "type": "object"
    },
    "SeverityLevel": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "SeverityLevel",
      "type": "string"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "properties": {
        "end_col": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Col"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "start_col": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Col"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "start_line",
        "end_line"
      ],
      "title": "SourceSpan",
      "type": "object"
    },
    "StatusChange": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "description": "'agent:<name>', 'user:<usr_id>' or 'system'",
          "maxLength": 500,
          "title": "Actor",
          "type": "string"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "from_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/FindingStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "to_status": {
          "$ref": "#/$defs/FindingStatus"
        }
      },
      "required": [
        "from_status",
        "to_status",
        "at",
        "actor"
      ],
      "title": "StatusChange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assessment_id": {
      "pattern": "^asm_[0-9A-Za-z_\\-]{8,64}$",
      "title": "Assessment Id",
      "type": "string"
    },
    "commit_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Commit Sha",
      "type": "string"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "expectation_ids": {
      "items": {
        "pattern": "^exp_[0-9A-Za-z_\\-]{8,64}$",
        "type": "string"
      },
      "title": "Expectation Ids",
      "type": "array"
    },
    "history": {
      "items": {
        "$ref": "#/$defs/StatusChange"
      },
      "title": "History",
      "type": "array"
    },
    "id": {
      "pattern": "^fnd_[0-9A-Za-z_\\-]{8,64}$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/FindingKind"
    },
    "produced_by_run_id": {
      "anyOf": [
        {
          "pattern": "^run_[0-9A-Za-z_\\-]{8,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Produced By Run Id"
    },
    "severity": {
      "anyOf": [
        {
          "$ref": "#/$defs/SeverityAssessment"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "snapshot_id": {
      "anyOf": [
        {
          "pattern": "^snp_[0-9A-Za-z_\\-]{8,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Snapshot Id"
    },
    "status": {
      "$ref": "#/$defs/FindingStatus"
    },
    "subject_refs": {
      "items": {
        "maxLength": 500,
        "type": "string"
      },
      "title": "Subject Refs",
      "type": "array"
    },
    "title": {
      "maxLength": 500,
      "title": "Title",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "assessment_id",
    "commit_sha",
    "kind",
    "title",
    "status",
    "evidence",
    "confidence",
    "created_at",
    "updated_at"
  ],
  "title": "Finding",
  "type": "object"
}
