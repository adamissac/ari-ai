{
  "$defs": {
    "ActorType": {
      "enum": [
        "user",
        "system",
        "agent",
        "github"
      ],
      "title": "ActorType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "description": "dotted verb, e.g. 'scope.approved'",
      "maxLength": 500,
      "title": "Action",
      "type": "string"
    },
    "actor_id": {
      "maxLength": 500,
      "title": "Actor Id",
      "type": "string"
    },
    "actor_type": {
      "$ref": "#/$defs/ActorType"
    },
    "at": {
      "format": "date-time",
      "title": "At",
      "type": "string"
    },
    "details": {
      "additionalProperties": true,
      "description": "Redacted JSON",
      "title": "Details",
      "type": "object"
    },
    "hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Hash",
      "type": "string"
    },
    "id": {
      "pattern": "^aud_[0-9A-Za-z_\\-]{8,64}$",
      "title": "Id",
      "type": "string"
    },
    "org_id": {
      "pattern": "^org_[0-9A-Za-z_\\-]{8,64}$",
      "title": "Org Id",
      "type": "string"
    },
    "prev_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Prev Hash",
      "type": "string"
    },
    "project_id": {
      "anyOf": [
        {
          "pattern": "^prj_[0-9A-Za-z_\\-]{8,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Id"
    },
    "seq": {
      "description": "Per-org monotonically increasing sequence",
      "minimum": 1,
      "title": "Seq",
      "type": "integer"
    },
    "subject_id": {
      "maxLength": 500,
      "title": "Subject Id",
      "type": "string"
    },
    "subject_type": {
      "maxLength": 500,
      "title": "Subject Type",
      "type": "string"
    }
  },
  "required": [
    "id",
    "seq",
    "org_id",
    "actor_type",
    "actor_id",
    "action",
    "subject_type",
    "subject_id",
    "at",
    "prev_hash",
    "hash"
  ],
  "title": "AuditEvent",
  "type": "object"
}
