{
  "$defs": {
    "DataSensitivity": {
      "enum": [
        "none",
        "internal",
        "personal",
        "financial"
      ],
      "title": "DataSensitivity",
      "type": "string"
    },
    "EvidenceKind": {
      "enum": [
        "source_span",
        "test_run",
        "sandbox_run",
        "tool_output",
        "artifact",
        "human_input",
        "doc",
        "change_intent",
        "monitoring_event"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "description": "Pointer to a piece of evidence pinned to an exact code version.\n\n``source_span`` evidence must carry ``path`` + ``commit_sha`` + ``span``;\nartifact-backed kinds must carry ``artifact_id`` + ``sha256``.",
      "properties": {
        "artifact_id": {
          "anyOf": [
            {
              "pattern": "^art_[0-9A-Za-z]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Id"
        },
        "commit_sha": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit Sha"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "path": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "provenance": {
          "description": "Producer and version, e.g. 'code_intelligence.indexer@0.1' or 'agent:probe'",
          "maxLength": 500,
          "title": "Provenance",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceSpan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "symbol": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Qualified symbol name or sym_ id",
          "title": "Symbol"
        }
      },
      "required": [
        "kind",
        "provenance"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "ExpectationKind": {
      "enum": [
        "functional",
        "authorization",
        "ownership",
        "validation",
        "invariant",
        "error_handling",
        "data_handling",
        "performance"
      ],
      "title": "ExpectationKind",
      "type": "string"
    },
    "ExpectationOrigin": {
      "enum": [
        "extracted",
        "inferred",
        "human_input"
      ],
      "title": "ExpectationOrigin",
      "type": "string"
    },
    "ExpectationStatus": {
      "enum": [
        "confirmed",
        "inferred",
        "ambiguous",
        "conflicting",
        "rejected"
      ],
      "title": "ExpectationStatus",
      "type": "string"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "properties": {
        "end_col": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Col"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "start_col": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Col"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "start_line",
        "end_line"
      ],
      "title": "SourceSpan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "data_sensitivity": {
      "anyOf": [
        {
          "$ref": "#/$defs/DataSensitivity"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "id": {
      "pattern": "^exp_[0-9A-Za-z]{8,64}$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/ExpectationKind"
    },
    "origin": {
      "$ref": "#/$defs/ExpectationOrigin"
    },
    "snapshot_id": {
      "pattern": "^snp_[0-9A-Za-z]{8,64}$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "statement": {
      "maxLength": 500,
      "title": "Statement",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ExpectationStatus"
    },
    "subject_ref": {
      "description": "sym_/ent_ id or qualified name",
      "maxLength": 500,
      "title": "Subject Ref",
      "type": "string"
    }
  },
  "required": [
    "id",
    "snapshot_id",
    "subject_ref",
    "statement",
    "kind",
    "sources",
    "confidence",
    "origin",
    "status"
  ],
  "title": "BehavioralExpectation",
  "type": "object"
}
