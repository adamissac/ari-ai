{
  "$defs": {
    "MemberRole": {
      "enum": [
        "owner",
        "member",
        "viewer"
      ],
      "title": "MemberRole",
      "type": "string"
    },
    "Organization": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "id": {
          "pattern": "^org_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 500,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "created_at"
      ],
      "title": "Organization",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "organization": {
      "$ref": "#/$defs/Organization"
    },
    "role": {
      "$ref": "#/$defs/MemberRole"
    }
  },
  "required": [
    "organization",
    "role"
  ],
  "title": "MembershipView",
  "type": "object"
}
