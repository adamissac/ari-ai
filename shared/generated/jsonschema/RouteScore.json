{
  "additionalProperties": false,
  "description": "Explainable per-route score against that route's own recent history.",
  "properties": {
    "alert_rate": {
      "description": "Number of triggered rules in this window",
      "minimum": 0,
      "title": "Alert Rate",
      "type": "number"
    },
    "anomaly_score": {
      "maximum": 1,
      "minimum": 0,
      "title": "Anomaly Score",
      "type": "number"
    },
    "auth_failure_ratio": {
      "maximum": 1,
      "minimum": 0,
      "title": "Auth Failure Ratio",
      "type": "number"
    },
    "auth_failure_ratio_delta": {
      "title": "Auth Failure Ratio Delta",
      "type": "number"
    },
    "error_ratio": {
      "maximum": 1,
      "minimum": 0,
      "title": "Error Ratio",
      "type": "number"
    },
    "error_ratio_delta": {
      "title": "Error Ratio Delta",
      "type": "number"
    },
    "history_windows": {
      "minimum": 0,
      "title": "History Windows",
      "type": "integer"
    },
    "reasons": {
      "items": {
        "maxLength": 500,
        "type": "string"
      },
      "title": "Reasons",
      "type": "array"
    },
    "request_rate_z": {
      "title": "Request Rate Z",
      "type": "number"
    },
    "route": {
      "title": "Route",
      "type": "string"
    },
    "source": {
      "enum": [
        "runtime_demo",
        "replay",
        "simulated",
        "drill",
        "owned_staging"
      ],
      "title": "Source",
      "type": "string"
    },
    "window_end": {
      "format": "date-time",
      "title": "Window End",
      "type": "string"
    }
  },
  "required": [
    "route",
    "source",
    "window_end",
    "request_rate_z",
    "error_ratio",
    "error_ratio_delta",
    "auth_failure_ratio",
    "auth_failure_ratio_delta",
    "history_windows",
    "alert_rate",
    "anomaly_score"
  ],
  "title": "RouteScore",
  "type": "object"
}
