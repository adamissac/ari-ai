{
  "$defs": {
    "ActionGrant": {
      "additionalProperties": false,
      "properties": {
        "app_id": {
          "pattern": "^lap_[0-9A-Za-z_\\-]{8,64}$",
          "title": "App Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "granted_by": {
          "title": "Granted By",
          "type": "string"
        },
        "hourly_budget": {
          "title": "Hourly Budget",
          "type": "integer"
        },
        "id": {
          "pattern": "^lgr_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/DefenseActionKind"
        },
        "max_duration_s": {
          "title": "Max Duration S",
          "type": "integer"
        },
        "revoked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Revoked At"
        }
      },
      "required": [
        "id",
        "app_id",
        "kind",
        "max_duration_s",
        "hourly_budget",
        "granted_by",
        "created_at",
        "revoked_at"
      ],
      "title": "ActionGrant",
      "type": "object"
    },
    "AppEnvironment": {
      "enum": [
        "owned_test",
        "staging",
        "production"
      ],
      "title": "AppEnvironment",
      "type": "string"
    },
    "ConnectedApp": {
      "additionalProperties": false,
      "properties": {
        "auto_response": {
          "title": "Auto Response",
          "type": "boolean"
        },
        "control_url": {
          "title": "Control Url",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "environment": {
          "$ref": "#/$defs/AppEnvironment"
        },
        "grants": {
          "items": {
            "$ref": "#/$defs/ActionGrant"
          },
          "title": "Grants",
          "type": "array"
        },
        "id": {
          "pattern": "^lap_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Id",
          "type": "string"
        },
        "last_event_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Event At"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "notify_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Notify Url"
        },
        "project_id": {
          "pattern": "^prj_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Project Id",
          "type": "string"
        },
        "protected_sources": {
          "items": {
            "type": "string"
          },
          "title": "Protected Sources",
          "type": "array"
        },
        "secret_storage": {
          "const": "encrypted",
          "title": "Secret Storage",
          "type": "string"
        }
      },
      "required": [
        "id",
        "project_id",
        "name",
        "environment",
        "control_url",
        "notify_url",
        "auto_response",
        "enabled",
        "protected_sources",
        "grants",
        "secret_storage",
        "created_at",
        "last_event_at"
      ],
      "title": "ConnectedApp",
      "type": "object"
    },
    "DefenseActionKind": {
      "enum": [
        "increase_logging",
        "rate_limit",
        "block_source",
        "escalate",
        "request_reassessment"
      ],
      "title": "DefenseActionKind",
      "type": "string"
    },
    "LiveCounts": {
      "additionalProperties": false,
      "properties": {
        "active_controls": {
          "title": "Active Controls",
          "type": "integer"
        },
        "active_incidents": {
          "title": "Active Incidents",
          "type": "integer"
        },
        "automatic_actions_executed": {
          "title": "Automatic Actions Executed",
          "type": "integer"
        },
        "escalated_incidents": {
          "title": "Escalated Incidents",
          "type": "integer"
        },
        "failed_incidents": {
          "title": "Failed Incidents",
          "type": "integer"
        },
        "pending_approvals": {
          "title": "Pending Approvals",
          "type": "integer"
        },
        "resolved_incidents": {
          "title": "Resolved Incidents",
          "type": "integer"
        }
      },
      "required": [
        "active_incidents",
        "resolved_incidents",
        "escalated_incidents",
        "failed_incidents",
        "automatic_actions_executed",
        "pending_approvals",
        "active_controls"
      ],
      "title": "LiveCounts",
      "type": "object"
    },
    "RLStatus": {
      "additionalProperties": false,
      "properties": {
        "configured": {
          "title": "Configured",
          "type": "boolean"
        },
        "loadable": {
          "title": "Loadable",
          "type": "boolean"
        },
        "policy_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Policy Version"
        },
        "reason": {
          "maxLength": 500,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "configured",
        "loadable",
        "policy_version",
        "reason"
      ],
      "title": "RLStatus",
      "type": "object"
    },
    "WorkerHealth": {
      "additionalProperties": false,
      "properties": {
        "age_s": {
          "title": "Age S",
          "type": "number"
        },
        "healthy": {
          "title": "Healthy",
          "type": "boolean"
        },
        "last_seen": {
          "format": "date-time",
          "title": "Last Seen",
          "type": "string"
        },
        "worker_id": {
          "title": "Worker Id",
          "type": "string"
        }
      },
      "required": [
        "worker_id",
        "last_seen",
        "age_s",
        "healthy"
      ],
      "title": "WorkerHealth",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "apps": {
      "items": {
        "$ref": "#/$defs/ConnectedApp"
      },
      "title": "Apps",
      "type": "array"
    },
    "counts": {
      "$ref": "#/$defs/LiveCounts"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "last_event_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Last Event At"
    },
    "monitoring": {
      "enum": [
        "active",
        "inactive",
        "offline",
        "stale"
      ],
      "title": "Monitoring",
      "type": "string"
    },
    "monitoring_reason": {
      "maxLength": 500,
      "title": "Monitoring Reason",
      "type": "string"
    },
    "project_id": {
      "pattern": "^prj_[0-9A-Za-z_\\-]{8,64}$",
      "title": "Project Id",
      "type": "string"
    },
    "rl": {
      "$ref": "#/$defs/RLStatus"
    },
    "stale_after_s": {
      "title": "Stale After S",
      "type": "integer"
    },
    "worker_healthy": {
      "title": "Worker Healthy",
      "type": "boolean"
    },
    "workers": {
      "items": {
        "$ref": "#/$defs/WorkerHealth"
      },
      "title": "Workers",
      "type": "array"
    }
  },
  "required": [
    "project_id",
    "monitoring",
    "monitoring_reason",
    "workers",
    "worker_healthy",
    "last_event_at",
    "stale_after_s",
    "apps",
    "rl",
    "counts",
    "generated_at"
  ],
  "title": "LiveStatus",
  "type": "object"
}
