{
  "$defs": {
    "ApprovalGate": {
      "enum": [
        "containment",
        "eradication",
        "recovery",
        "closure"
      ],
      "title": "ApprovalGate",
      "type": "string"
    },
    "CatalogStatus": {
      "enum": [
        "active",
        "deprecated",
        "revoked"
      ],
      "title": "CatalogStatus",
      "type": "string"
    },
    "ClosureCriterion": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 500,
          "title": "Description",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence",
          "type": "array"
        },
        "key": {
          "maxLength": 500,
          "title": "Key",
          "type": "string"
        },
        "satisfied": {
          "default": false,
          "title": "Satisfied",
          "type": "boolean"
        },
        "satisfied_by": {
          "anyOf": [
            {
              "pattern": "^usr_[0-9A-Za-z_\\-]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Satisfied By"
        }
      },
      "required": [
        "key",
        "description"
      ],
      "title": "ClosureCriterion",
      "type": "object"
    },
    "CommunicationRecord": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "audience": {
          "enum": [
            "internal",
            "external",
            "customer",
            "regulator",
            "law_enforcement"
          ],
          "title": "Audience",
          "type": "string"
        },
        "channel": {
          "maxLength": 500,
          "title": "Channel",
          "type": "string"
        },
        "csf_ref": {
          "enum": [
            "RS.CO-02",
            "RS.CO-03",
            "RC.CO-03"
          ],
          "title": "Csf Ref",
          "type": "string"
        },
        "recorded_by": {
          "pattern": "^usr_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Recorded By",
          "type": "string"
        },
        "summary": {
          "maxLength": 500,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "at",
        "audience",
        "channel",
        "summary",
        "recorded_by",
        "csf_ref"
      ],
      "title": "CommunicationRecord",
      "type": "object"
    },
    "EvidenceKind": {
      "enum": [
        "source_span",
        "test_run",
        "sandbox_run",
        "tool_output",
        "artifact",
        "human_input",
        "doc",
        "change_intent",
        "monitoring_event"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "description": "Pointer to a piece of evidence pinned to an exact code version.\n\n``source_span`` evidence must carry ``path`` + ``commit_sha`` + ``span``;\nartifact-backed kinds must carry ``artifact_id`` + ``sha256``.",
      "properties": {
        "artifact_id": {
          "anyOf": [
            {
              "pattern": "^art_[0-9A-Za-z_\\-]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Id"
        },
        "commit_sha": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit Sha"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "path": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "provenance": {
          "description": "Producer and version, e.g. 'code_intelligence.indexer@0.1' or 'agent:probe'",
          "maxLength": 500,
          "title": "Provenance",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceSpan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "symbol": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Qualified symbol name or sym_ id",
          "title": "Symbol"
        }
      },
      "required": [
        "kind",
        "provenance"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "Incident": {
      "additionalProperties": false,
      "properties": {
        "approvals": {
          "items": {
            "$ref": "#/$defs/IncidentApproval"
          },
          "title": "Approvals",
          "type": "array"
        },
        "attack": {
          "items": {
            "$ref": "#/$defs/StandardMapping"
          },
          "title": "Attack",
          "type": "array"
        },
        "business_priority": {
          "default": "unset",
          "enum": [
            "unset",
            "p1",
            "p2",
            "p3",
            "p4"
          ],
          "title": "Business Priority",
          "type": "string"
        },
        "closed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Closed At"
        },
        "closure_criteria": {
          "items": {
            "$ref": "#/$defs/ClosureCriterion"
          },
          "title": "Closure Criteria",
          "type": "array"
        },
        "communications": {
          "items": {
            "$ref": "#/$defs/CommunicationRecord"
          },
          "title": "Communications",
          "type": "array"
        },
        "csf_function": {
          "enum": [
            "GV",
            "ID",
            "PR",
            "DE",
            "RS",
            "RC"
          ],
          "title": "Csf Function",
          "type": "string"
        },
        "escalation_level": {
          "default": 0,
          "maximum": 5,
          "minimum": 0,
          "title": "Escalation Level",
          "type": "integer"
        },
        "finding_ids": {
          "items": {
            "pattern": "^fnd_[0-9A-Za-z_\\-]{8,64}$",
            "type": "string"
          },
          "title": "Finding Ids",
          "type": "array"
        },
        "id": {
          "pattern": "^inc_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Id",
          "type": "string"
        },
        "lessons_learned": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lessons Learned"
        },
        "lessons_learned_evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Lessons Learned Evidence",
          "type": "array"
        },
        "monitoring_event_ids": {
          "items": {
            "pattern": "^evt_[0-9A-Za-z_\\-]{8,64}$",
            "type": "string"
          },
          "title": "Monitoring Event Ids",
          "type": "array"
        },
        "opened_at": {
          "format": "date-time",
          "title": "Opened At",
          "type": "string"
        },
        "opened_by": {
          "maxLength": 500,
          "title": "Opened By",
          "type": "string"
        },
        "owner": {
          "anyOf": [
            {
              "pattern": "^usr_[0-9A-Za-z_\\-]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner"
        },
        "project_id": {
          "pattern": "^prj_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Project Id",
          "type": "string"
        },
        "recommendation_ids": {
          "items": {
            "pattern": "^rec_[0-9A-Za-z_\\-]{8,64}$",
            "type": "string"
          },
          "title": "Recommendation Ids",
          "type": "array"
        },
        "severity": {
          "anyOf": [
            {
              "enum": [
                "info",
                "low",
                "medium",
                "high",
                "critical"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Severity"
        },
        "simulated": {
          "description": "True when opened only from demo/replay/simulated signals",
          "title": "Simulated",
          "type": "boolean"
        },
        "state": {
          "$ref": "#/$defs/IncidentState"
        },
        "timeline": {
          "items": {
            "$ref": "#/$defs/IncidentTimelineEntry"
          },
          "minItems": 1,
          "title": "Timeline",
          "type": "array"
        },
        "title": {
          "maxLength": 500,
          "title": "Title",
          "type": "string"
        },
        "triage": {
          "anyOf": [
            {
              "$ref": "#/$defs/TriageDecision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "verification_ids": {
          "items": {
            "pattern": "^ver_[0-9A-Za-z_\\-]{8,64}$",
            "type": "string"
          },
          "title": "Verification Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "project_id",
        "title",
        "state",
        "csf_function",
        "simulated",
        "timeline",
        "opened_by",
        "opened_at"
      ],
      "title": "Incident",
      "type": "object"
    },
    "IncidentApproval": {
      "additionalProperties": false,
      "description": "Two-person rule: the decider must differ from the requester and hold the owner role.",
      "properties": {
        "action_summary": {
          "description": "What a human will do (containment/eradication are never executed by the platform)",
          "maxLength": 500,
          "title": "Action Summary",
          "type": "string"
        },
        "decided_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decided At"
        },
        "decided_by": {
          "anyOf": [
            {
              "pattern": "^usr_[0-9A-Za-z_\\-]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decided By"
        },
        "gate": {
          "$ref": "#/$defs/ApprovalGate"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "requested_at": {
          "format": "date-time",
          "title": "Requested At",
          "type": "string"
        },
        "requested_by": {
          "pattern": "^usr_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Requested By",
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "approved",
            "declined"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "gate",
        "status",
        "action_summary",
        "requested_by",
        "requested_at"
      ],
      "title": "IncidentApproval",
      "type": "object"
    },
    "IncidentState": {
      "enum": [
        "reported",
        "triaged",
        "analysis",
        "containment",
        "eradication",
        "recovery",
        "closed",
        "rejected"
      ],
      "title": "IncidentState",
      "type": "string"
    },
    "IncidentTimelineAction": {
      "enum": [
        "reported",
        "triaged",
        "owner_assigned",
        "escalated",
        "state_changed",
        "approval_requested",
        "approval_decided",
        "evidence_linked",
        "communication_recorded",
        "closure_criterion_updated",
        "lessons_learned_recorded",
        "denied"
      ],
      "title": "IncidentTimelineAction",
      "type": "string"
    },
    "IncidentTimelineEntry": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/IncidentTimelineAction"
        },
        "actor": {
          "description": "'user:<usr_id>' or 'system'",
          "maxLength": 500,
          "title": "Actor",
          "type": "string"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "audit_event_id": {
          "anyOf": [
            {
              "pattern": "^aud_[0-9A-Za-z_\\-]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audit Event Id"
        },
        "csf_refs": {
          "items": {
            "maxLength": 500,
            "type": "string"
          },
          "title": "Csf Refs",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence",
          "type": "array"
        },
        "from_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/IncidentState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "note": {
          "maxLength": 500,
          "title": "Note",
          "type": "string"
        },
        "to_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/IncidentState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "at",
        "actor",
        "action",
        "note"
      ],
      "title": "IncidentTimelineEntry",
      "type": "object"
    },
    "MappedVia": {
      "description": "How a mapping was derived. Never ``model``: model proposals go through ``rule``/``human``.",
      "enum": [
        "check_template_rule",
        "catalog_relation",
        "reviewed_rule_table",
        "validated_proposal",
        "human"
      ],
      "title": "MappedVia",
      "type": "string"
    },
    "Observation": {
      "description": "What kind of evidence the mapping rests on.",
      "enum": [
        "observed_in_sandbox",
        "observed_runtime",
        "simulated",
        "hypothesis"
      ],
      "title": "Observation",
      "type": "string"
    },
    "ReviewStatus": {
      "enum": [
        "proposed",
        "accepted",
        "rejected"
      ],
      "title": "ReviewStatus",
      "type": "string"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "properties": {
        "end_col": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Col"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "start_col": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Col"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "start_line",
        "end_line"
      ],
      "title": "SourceSpan",
      "type": "object"
    },
    "StandardFramework": {
      "enum": [
        "attack",
        "d3fend",
        "cwe",
        "owasp_llm",
        "nist_csf"
      ],
      "title": "StandardFramework",
      "type": "string"
    },
    "StandardMapping": {
      "additionalProperties": false,
      "properties": {
        "catalog_status": {
          "$ref": "#/$defs/CatalogStatus",
          "default": "active"
        },
        "catalog_version": {
          "maxLength": 500,
          "title": "Catalog Version",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "framework": {
          "$ref": "#/$defs/StandardFramework"
        },
        "id": {
          "description": "Catalog identifier, e.g. T1190, D3-AMED, CWE-639, LLM01:2025",
          "maxLength": 500,
          "title": "Id",
          "type": "string"
        },
        "legacy": {
          "default": false,
          "description": "Imported under an older catalog release",
          "title": "Legacy",
          "type": "boolean"
        },
        "mapped_via": {
          "$ref": "#/$defs/MappedVia"
        },
        "name": {
          "description": "Name from the catalog, never model text",
          "maxLength": 500,
          "title": "Name",
          "type": "string"
        },
        "observation": {
          "$ref": "#/$defs/Observation"
        },
        "rationale": {
          "maxLength": 500,
          "title": "Rationale",
          "type": "string"
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatus",
          "default": "proposed"
        },
        "reviewed_by": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed By"
        },
        "rule_id": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Rule-table row that produced it",
          "title": "Rule Id"
        },
        "url": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "framework",
        "id",
        "name",
        "catalog_version",
        "mapped_via",
        "observation",
        "rationale",
        "confidence",
        "evidence"
      ],
      "title": "StandardMapping",
      "type": "object"
    },
    "TriageDecision": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "maxLength": 500,
          "title": "Category",
          "type": "string"
        },
        "decided_at": {
          "format": "date-time",
          "title": "Decided At",
          "type": "string"
        },
        "decided_by": {
          "pattern": "^usr_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Decided By",
          "type": "string"
        },
        "decision": {
          "$ref": "#/$defs/TriageDecisionKind"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence",
          "type": "array"
        },
        "rationale": {
          "maxLength": 500,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "decision",
        "category",
        "rationale",
        "decided_by",
        "decided_at"
      ],
      "title": "TriageDecision",
      "type": "object"
    },
    "TriageDecisionKind": {
      "enum": [
        "confirmed_incident",
        "not_an_incident",
        "duplicate"
      ],
      "title": "TriageDecisionKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "incident": {
      "$ref": "#/$defs/Incident"
    },
    "standards": {
      "additionalProperties": true,
      "title": "Standards",
      "type": "object"
    }
  },
  "required": [
    "incident"
  ],
  "title": "IncidentDetail",
  "type": "object"
}
