{
  "$defs": {
    "FeatureContribution": {
      "additionalProperties": false,
      "properties": {
        "delta_margin": {
          "description": "margin(original) - margin(feature occluded); > 0 supports the chosen action",
          "title": "Delta Margin",
          "type": "number"
        },
        "feature": {
          "maxLength": 500,
          "title": "Feature",
          "type": "string"
        },
        "kind": {
          "enum": [
            "signal",
            "context",
            "defense_state",
            "global"
          ],
          "title": "Kind",
          "type": "string"
        },
        "node": {
          "anyOf": [
            {
              "enum": [
                "gateway",
                "api",
                "auth",
                "payments",
                "db"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "None for global features",
          "title": "Node"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "node",
        "feature",
        "value",
        "delta_margin",
        "kind"
      ],
      "title": "FeatureContribution",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Occlusion explanation of one recommendation (V0.1, proposed by Adam). Explains the\nsimulation-trained policy's decision, not real-world causality.",
  "properties": {
    "action": {
      "maxLength": 500,
      "title": "Action",
      "type": "string"
    },
    "caveat": {
      "maxLength": 500,
      "title": "Caveat",
      "type": "string"
    },
    "margin": {
      "title": "Margin",
      "type": "number"
    },
    "method": {
      "maxLength": 500,
      "title": "Method",
      "type": "string"
    },
    "recommendation_id": {
      "pattern": "^rec_[0-9A-Za-z]{8,64}$",
      "title": "Recommendation Id",
      "type": "string"
    },
    "runner_up": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Runner Up"
    },
    "simulation_derived": {
      "const": true,
      "default": true,
      "title": "Simulation Derived",
      "type": "boolean"
    },
    "top_contributions": {
      "items": {
        "$ref": "#/$defs/FeatureContribution"
      },
      "title": "Top Contributions",
      "type": "array"
    }
  },
  "required": [
    "recommendation_id",
    "action",
    "runner_up",
    "margin",
    "method",
    "top_contributions",
    "caveat"
  ],
  "title": "RLExplanation",
  "type": "object"
}
