{
  "$defs": {
    "DefenseActionKind": {
      "enum": [
        "increase_logging",
        "rate_limit",
        "block_source",
        "escalate",
        "request_reassessment"
      ],
      "title": "DefenseActionKind",
      "type": "string"
    },
    "RLActionScore": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "title": "Action",
          "type": "string"
        },
        "node": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Node"
        },
        "q_value": {
          "title": "Q Value",
          "type": "number"
        }
      },
      "required": [
        "action",
        "node",
        "q_value"
      ],
      "title": "RLActionScore",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "What the learned policy said. Present even when it was not used.",
  "properties": {
    "action": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Action"
    },
    "checkpoint_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Checkpoint Sha256"
    },
    "explanation": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Explanation"
    },
    "mapped_kind": {
      "anyOf": [
        {
          "$ref": "#/$defs/DefenseActionKind"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "mapping_note": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mapping Note"
    },
    "node": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Node"
    },
    "observation_provenance": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Observation Provenance",
      "type": "object"
    },
    "policy_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Policy Version"
    },
    "q_margin": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Q Margin"
    },
    "reason": {
      "maxLength": 500,
      "title": "Reason",
      "type": "string"
    },
    "status": {
      "enum": [
        "ok",
        "unavailable",
        "error",
        "rejected_input"
      ],
      "title": "Status",
      "type": "string"
    },
    "top_actions": {
      "items": {
        "$ref": "#/$defs/RLActionScore"
      },
      "title": "Top Actions",
      "type": "array"
    },
    "trained_in": {
      "default": "DefenseSimEnv simulation (offline training); live inference only here",
      "maxLength": 500,
      "title": "Trained In",
      "type": "string"
    }
  },
  "required": [
    "status",
    "reason"
  ],
  "title": "RLInference",
  "type": "object"
}
