{
  "$defs": {
    "ActionScore": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "noop",
            "raise_monitoring",
            "rate_limit",
            "isolate",
            "request_reassessment",
            "escalate_to_human",
            "block_principal",
            "block_principal_long",
            "block_top_principal_long"
          ],
          "title": "Action",
          "type": "string"
        },
        "node": {
          "anyOf": [
            {
              "enum": [
                "gateway",
                "api",
                "auth",
                "payments",
                "db"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Node"
        },
        "q_value": {
          "title": "Q Value",
          "type": "number"
        }
      },
      "required": [
        "action",
        "node",
        "q_value"
      ],
      "title": "ActionScore",
      "type": "object"
    },
    "CatalogStatus": {
      "enum": [
        "active",
        "deprecated",
        "revoked"
      ],
      "title": "CatalogStatus",
      "type": "string"
    },
    "ControlStatus": {
      "enum": [
        "proposed",
        "implemented",
        "tested"
      ],
      "title": "ControlStatus",
      "type": "string"
    },
    "DefensiveMapping": {
      "additionalProperties": false,
      "properties": {
        "catalog_status": {
          "$ref": "#/$defs/CatalogStatus",
          "default": "active"
        },
        "catalog_version": {
          "maxLength": 500,
          "title": "Catalog Version",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "control_status": {
          "$ref": "#/$defs/ControlStatus",
          "default": "proposed"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "framework": {
          "$ref": "#/$defs/StandardFramework"
        },
        "hardening_id": {
          "anyOf": [
            {
              "pattern": "^hdn_[0-9A-Za-z_\\-]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hardening Id"
        },
        "id": {
          "description": "Catalog identifier, e.g. T1190, D3-AMED, CWE-639, LLM01:2025",
          "maxLength": 500,
          "title": "Id",
          "type": "string"
        },
        "legacy": {
          "default": false,
          "description": "Imported under an older catalog release",
          "title": "Legacy",
          "type": "boolean"
        },
        "mapped_via": {
          "$ref": "#/$defs/MappedVia"
        },
        "name": {
          "description": "Name from the catalog, never model text",
          "maxLength": 500,
          "title": "Name",
          "type": "string"
        },
        "observation": {
          "$ref": "#/$defs/Observation"
        },
        "rationale": {
          "maxLength": 500,
          "title": "Rationale",
          "type": "string"
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatus",
          "default": "proposed"
        },
        "reviewed_by": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed By"
        },
        "rule_id": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Rule-table row that produced it",
          "title": "Rule Id"
        },
        "simulation_derived": {
          "default": false,
          "title": "Simulation Derived",
          "type": "boolean"
        },
        "url": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "framework",
        "id",
        "name",
        "catalog_version",
        "mapped_via",
        "observation",
        "rationale",
        "confidence",
        "evidence"
      ],
      "title": "DefensiveMapping",
      "type": "object"
    },
    "EvidenceKind": {
      "enum": [
        "source_span",
        "test_run",
        "sandbox_run",
        "tool_output",
        "artifact",
        "human_input",
        "doc",
        "change_intent",
        "monitoring_event"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "description": "Pointer to a piece of evidence pinned to an exact code version.\n\n``source_span`` evidence must carry ``path`` + ``commit_sha`` + ``span``;\nartifact-backed kinds must carry ``artifact_id`` + ``sha256``.",
      "properties": {
        "artifact_id": {
          "anyOf": [
            {
              "pattern": "^art_[0-9A-Za-z_\\-]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Id"
        },
        "commit_sha": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit Sha"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "path": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "provenance": {
          "description": "Producer and version, e.g. 'code_intelligence.indexer@0.1' or 'agent:probe'",
          "maxLength": 500,
          "title": "Provenance",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceSpan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "symbol": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Qualified symbol name or sym_ id",
          "title": "Symbol"
        }
      },
      "required": [
        "kind",
        "provenance"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "MappedVia": {
      "description": "How a mapping was derived. Never ``model``: model proposals go through ``rule``/``human``.",
      "enum": [
        "check_template_rule",
        "catalog_relation",
        "reviewed_rule_table",
        "validated_proposal",
        "human"
      ],
      "title": "MappedVia",
      "type": "string"
    },
    "Observation": {
      "description": "What kind of evidence the mapping rests on.",
      "enum": [
        "observed_in_sandbox",
        "observed_runtime",
        "simulated",
        "hypothesis"
      ],
      "title": "Observation",
      "type": "string"
    },
    "ReviewStatus": {
      "enum": [
        "proposed",
        "accepted",
        "rejected"
      ],
      "title": "ReviewStatus",
      "type": "string"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "properties": {
        "end_col": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Col"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "start_col": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Col"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "start_line",
        "end_line"
      ],
      "title": "SourceSpan",
      "type": "object"
    },
    "StandardFramework": {
      "enum": [
        "attack",
        "d3fend",
        "cwe",
        "owasp_llm",
        "nist_csf"
      ],
      "title": "StandardFramework",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "noop",
        "raise_monitoring",
        "rate_limit",
        "isolate",
        "request_reassessment",
        "escalate_to_human",
        "block_principal",
        "block_principal_long",
        "block_top_principal_long"
      ],
      "title": "Action",
      "type": "string"
    },
    "caveat": {
      "default": "Simulation-derived recommendation from a policy trained only in DefenseSimEnv; not a detection of a real attack and never executed automatically.",
      "maxLength": 500,
      "title": "Caveat",
      "type": "string"
    },
    "checkpoint_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Checkpoint Sha256",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "d3fend": {
      "items": {
        "$ref": "#/$defs/DefensiveMapping"
      },
      "title": "D3Fend",
      "type": "array"
    },
    "id": {
      "pattern": "^rec_[0-9A-Za-z_\\-]{8,64}$",
      "title": "Id",
      "type": "string"
    },
    "node": {
      "anyOf": [
        {
          "enum": [
            "gateway",
            "api",
            "auth",
            "payments",
            "db"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Node"
    },
    "observation": {
      "items": {
        "type": "number"
      },
      "title": "Observation",
      "type": "array"
    },
    "policy_version": {
      "description": "env id + checkpoint sha256 prefix",
      "maxLength": 500,
      "title": "Policy Version",
      "type": "string"
    },
    "principal_targets": {
      "description": "for block_principal* actions: the pseudonymous principals the block would cover (contracts 0.14); the operator maps them back. Never executed.",
      "items": {
        "description": "Pseudonymous principal reference chosen by the reporter (e.g. an HMAC of its user id under a key the platform never sees); never an email or raw id",
        "pattern": "^prn_[A-Za-z0-9_-]{4,64}$",
        "type": "string"
      },
      "maxItems": 500,
      "title": "Principal Targets",
      "type": "array"
    },
    "project_id": {
      "anyOf": [
        {
          "pattern": "^prj_[0-9A-Za-z_\\-]{8,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Project Id"
    },
    "q_margin": {
      "description": "Q(best) - Q(second best valid action)",
      "title": "Q Margin",
      "type": "number"
    },
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "simulation_derived": {
      "const": true,
      "default": true,
      "title": "Simulation Derived",
      "type": "boolean"
    },
    "top_actions": {
      "items": {
        "$ref": "#/$defs/ActionScore"
      },
      "title": "Top Actions",
      "type": "array"
    }
  },
  "required": [
    "id",
    "project_id",
    "policy_version",
    "checkpoint_sha256",
    "action",
    "node",
    "q_margin",
    "top_actions",
    "observation",
    "created_at"
  ],
  "title": "DefenseRecommendation",
  "type": "object"
}
