{
  "$defs": {
    "DefenseActionKind": {
      "enum": [
        "increase_logging",
        "rate_limit",
        "block_source",
        "escalate",
        "request_reassessment"
      ],
      "title": "DefenseActionKind",
      "type": "string"
    },
    "DefenseActionStatus": {
      "enum": [
        "pending_approval",
        "authorized",
        "executing",
        "active",
        "verified",
        "verification_failed",
        "failed",
        "denied",
        "expired",
        "rollback_requested",
        "rolled_back",
        "recorded"
      ],
      "title": "DefenseActionStatus",
      "type": "string"
    },
    "VerificationOutcome": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "title": "Attempt",
          "type": "integer"
        },
        "attempts_after": {
          "title": "Attempts After",
          "type": "integer"
        },
        "blocked_after": {
          "title": "Blocked After",
          "type": "integer"
        },
        "checked_at": {
          "format": "date-time",
          "title": "Checked At",
          "type": "string"
        },
        "control_state": {
          "title": "Control State",
          "type": "string"
        },
        "detail": {
          "maxLength": 500,
          "title": "Detail",
          "type": "string"
        },
        "result": {
          "enum": [
            "effective",
            "ineffective",
            "inconclusive",
            "pending"
          ],
          "title": "Result",
          "type": "string"
        }
      },
      "required": [
        "result",
        "control_state",
        "blocked_after",
        "attempts_after",
        "attempt",
        "checked_at",
        "detail"
      ],
      "title": "VerificationOutcome",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "activated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Activated At"
    },
    "adapter": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "title": "Adapter"
    },
    "app_id": {
      "pattern": "^lap_[0-9A-Za-z_\\-]{8,64}$",
      "title": "App Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "decided_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Decided By"
    },
    "duration_s": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Duration S"
    },
    "end_reason": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "End Reason"
    },
    "ended_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Ended At"
    },
    "error": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Error"
    },
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Expires At"
    },
    "id": {
      "pattern": "^dac_[0-9A-Za-z_\\-]{8,64}$",
      "title": "Id",
      "type": "string"
    },
    "incident_id": {
      "pattern": "^lin_[0-9A-Za-z_\\-]{8,64}$",
      "title": "Incident Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/DefenseActionKind"
    },
    "mode": {
      "anyOf": [
        {
          "enum": [
            "automatic",
            "human_approved",
            "internal"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Mode"
    },
    "status": {
      "$ref": "#/$defs/DefenseActionStatus"
    },
    "target": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Target"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "verification": {
      "anyOf": [
        {
          "$ref": "#/$defs/VerificationOutcome"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "incident_id",
    "app_id",
    "kind",
    "target",
    "duration_s",
    "status",
    "mode",
    "decided_by",
    "created_at",
    "updated_at",
    "activated_at",
    "expires_at",
    "ended_at",
    "end_reason",
    "verification",
    "adapter",
    "error"
  ],
  "title": "DefenseAction",
  "type": "object"
}
