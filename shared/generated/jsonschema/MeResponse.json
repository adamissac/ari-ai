{
  "$defs": {
    "MemberRole": {
      "enum": [
        "owner",
        "member",
        "viewer"
      ],
      "title": "MemberRole",
      "type": "string"
    },
    "MembershipView": {
      "additionalProperties": false,
      "properties": {
        "organization": {
          "$ref": "#/$defs/Organization"
        },
        "role": {
          "$ref": "#/$defs/MemberRole"
        }
      },
      "required": [
        "organization",
        "role"
      ],
      "title": "MembershipView",
      "type": "object"
    },
    "Organization": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "id": {
          "pattern": "^org_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 500,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "created_at"
      ],
      "title": "Organization",
      "type": "object"
    },
    "User": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "display_name": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "github_login": {
          "maxLength": 500,
          "title": "Github Login",
          "type": "string"
        },
        "id": {
          "pattern": "^usr_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "github_login",
        "created_at"
      ],
      "title": "User",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "csrf_token": {
      "maxLength": 500,
      "title": "Csrf Token",
      "type": "string"
    },
    "memberships": {
      "items": {
        "$ref": "#/$defs/MembershipView"
      },
      "title": "Memberships",
      "type": "array"
    },
    "user": {
      "$ref": "#/$defs/User"
    }
  },
  "required": [
    "user",
    "memberships",
    "csrf_token"
  ],
  "title": "MeResponse",
  "type": "object"
}
