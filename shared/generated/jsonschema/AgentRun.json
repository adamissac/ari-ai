{
  "$defs": {
    "AgentName": {
      "enum": [
        "scout",
        "probe",
        "trace",
        "diagnose",
        "patch",
        "fortify",
        "verify",
        "reviewer"
      ],
      "title": "AgentName",
      "type": "string"
    },
    "AgentRunStatus": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "AgentRunStatus",
      "type": "string"
    },
    "ErrorBody": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "message": {
          "maxLength": 500,
          "title": "Message",
          "type": "string"
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorBody",
      "type": "object"
    },
    "ErrorCode": {
      "enum": [
        "SCOPE_DENIED",
        "APPROVAL_REQUIRED",
        "BUDGET_EXHAUSTED",
        "SCHEMA_INVALID",
        "SANDBOX_START_FAILED",
        "SANDBOX_TIMEOUT",
        "SANDBOX_POLICY_VIOLATION",
        "TOOL_NOT_ALLOWED",
        "SNAPSHOT_NOT_READY",
        "WEBHOOK_SIGNATURE_INVALID",
        "LLM_UNAVAILABLE",
        "CONFLICT_STATE",
        "LLM_REFUSAL",
        "LLM_OUTPUT_TRUNCATED",
        "UNAUTHENTICATED",
        "FORBIDDEN",
        "CSRF_FAILED",
        "NOT_FOUND",
        "VALIDATION_FAILED",
        "RATE_LIMITED",
        "PAYLOAD_TOO_LARGE",
        "IDEMPOTENCY_CONFLICT",
        "SUBSYSTEM_UNAVAILABLE",
        "CANCELLED",
        "JOB_LEASE_EXPIRED",
        "INTERNAL"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "ToolCallOutcome": {
      "enum": [
        "ok",
        "error",
        "denied"
      ],
      "title": "ToolCallOutcome",
      "type": "string"
    },
    "ToolCallRecord": {
      "additionalProperties": false,
      "description": "One tool invocation requested by an agent, as enforced by the tool registry.",
      "properties": {
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "error_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorCode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/ToolCallOutcome"
        },
        "output_artifact_id": {
          "anyOf": [
            {
              "pattern": "^art_[0-9A-Za-z]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Artifact Id"
        },
        "tool_name": {
          "maxLength": 500,
          "title": "Tool Name",
          "type": "string"
        },
        "turn": {
          "minimum": 0,
          "title": "Turn",
          "type": "integer"
        }
      },
      "required": [
        "turn",
        "tool_name",
        "input_sha256",
        "outcome",
        "duration_ms"
      ],
      "title": "ToolCallRecord",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "cache_read_input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Cache Read Input Tokens",
          "type": "integer"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "llm_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Llm Calls",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "sandbox_seconds": {
          "default": 0.0,
          "minimum": 0,
          "title": "Sandbox Seconds",
          "type": "number"
        },
        "tool_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Tool Calls",
          "type": "integer"
        },
        "usd": {
          "default": 0.0,
          "minimum": 0,
          "title": "Usd",
          "type": "number"
        }
      },
      "title": "Usage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent": {
      "$ref": "#/$defs/AgentName"
    },
    "assessment_id": {
      "pattern": "^asm_[0-9A-Za-z]{8,64}$",
      "title": "Assessment Id",
      "type": "string"
    },
    "attempt": {
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "ended_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ended At"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorBody"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "id": {
      "pattern": "^run_[0-9A-Za-z]{8,64}$",
      "title": "Id",
      "type": "string"
    },
    "input_artifact_id": {
      "anyOf": [
        {
          "pattern": "^art_[0-9A-Za-z]{8,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Artifact Id"
    },
    "model_id": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Id"
    },
    "output_artifact_id": {
      "anyOf": [
        {
          "pattern": "^art_[0-9A-Za-z]{8,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Artifact Id"
    },
    "prompt_version": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Version"
    },
    "provider_mode": {
      "description": "'live' (real provider), 'replay' (recorded) or 'fake' (test transport)",
      "maxLength": 500,
      "title": "Provider Mode",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/AgentRunStatus"
    },
    "step_key": {
      "description": "Orchestrator step, e.g. 'recon' or 'patch:fnd_\u2026'",
      "maxLength": 500,
      "title": "Step Key",
      "type": "string"
    },
    "tool_calls": {
      "items": {
        "$ref": "#/$defs/ToolCallRecord"
      },
      "title": "Tool Calls",
      "type": "array"
    },
    "transcript_artifact_id": {
      "anyOf": [
        {
          "pattern": "^art_[0-9A-Za-z]{8,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Transcript Artifact Id"
    },
    "usage": {
      "$ref": "#/$defs/Usage"
    }
  },
  "required": [
    "id",
    "assessment_id",
    "agent",
    "step_key",
    "attempt",
    "status",
    "provider_mode",
    "started_at"
  ],
  "title": "AgentRun",
  "type": "object"
}
