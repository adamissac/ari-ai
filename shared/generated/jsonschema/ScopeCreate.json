{
  "$defs": {
    "CheckCategory": {
      "description": "Probe template-library categories (SEC-005) plus published V0 fixture aliases.\n\nCanonical ids are the Probe library values. The two fixture strings are the\nsame categories and canonicalize onto them; they remain valid stored values\nso published ``AuthorizedScope`` fixtures round-trip unchanged.",
      "enum": [
        "access_control.ownership",
        "input_validation.bounds",
        "authorization.ownership",
        "input.bounds"
      ],
      "title": "CheckCategory",
      "type": "string"
    },
    "ScopeTarget": {
      "additionalProperties": false,
      "description": "MVP permits only targets built from the connected repo inside our sandbox.",
      "properties": {
        "build_recipe_ref": {
          "description": "e.g. examples/payments-lite/sandbox.yaml",
          "maxLength": 500,
          "title": "Build Recipe Ref",
          "type": "string"
        },
        "exposed_ports": {
          "items": {
            "type": "integer"
          },
          "maxItems": 8,
          "title": "Exposed Ports",
          "type": "array"
        },
        "kind": {
          "const": "sandbox_build",
          "default": "sandbox_build",
          "title": "Kind",
          "type": "string"
        },
        "repo_id": {
          "pattern": "^rep_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Repo Id",
          "type": "string"
        }
      },
      "required": [
        "repo_id",
        "build_recipe_ref"
      ],
      "title": "ScopeTarget",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "allowed_check_categories": {
      "items": {
        "$ref": "#/$defs/CheckCategory"
      },
      "title": "Allowed Check Categories",
      "type": "array"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "name": {
      "maxLength": 500,
      "title": "Name",
      "type": "string"
    },
    "notes": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    },
    "targets": {
      "items": {
        "$ref": "#/$defs/ScopeTarget"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Targets",
      "type": "array"
    }
  },
  "required": [
    "name",
    "targets",
    "expires_at"
  ],
  "title": "ScopeCreate",
  "type": "object"
}
