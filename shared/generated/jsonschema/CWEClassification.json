{
  "$defs": {
    "CatalogStatus": {
      "enum": [
        "active",
        "deprecated",
        "revoked"
      ],
      "title": "CatalogStatus",
      "type": "string"
    },
    "EvidenceKind": {
      "enum": [
        "source_span",
        "test_run",
        "sandbox_run",
        "tool_output",
        "artifact",
        "human_input",
        "doc",
        "change_intent",
        "monitoring_event"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "description": "Pointer to a piece of evidence pinned to an exact code version.\n\n``source_span`` evidence must carry ``path`` + ``commit_sha`` + ``span``;\nartifact-backed kinds must carry ``artifact_id`` + ``sha256``.",
      "properties": {
        "artifact_id": {
          "anyOf": [
            {
              "pattern": "^art_[0-9A-Za-z_\\-]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Id"
        },
        "commit_sha": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit Sha"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "path": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "provenance": {
          "description": "Producer and version, e.g. 'code_intelligence.indexer@0.1' or 'agent:probe'",
          "maxLength": 500,
          "title": "Provenance",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceSpan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "symbol": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Qualified symbol name or sym_ id",
          "title": "Symbol"
        }
      },
      "required": [
        "kind",
        "provenance"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "MappedVia": {
      "description": "How a mapping was derived. Never ``model``: model proposals go through ``rule``/``human``.",
      "enum": [
        "check_template_rule",
        "catalog_relation",
        "reviewed_rule_table",
        "validated_proposal",
        "human"
      ],
      "title": "MappedVia",
      "type": "string"
    },
    "Observation": {
      "description": "What kind of evidence the mapping rests on.",
      "enum": [
        "observed_in_sandbox",
        "observed_runtime",
        "simulated",
        "hypothesis"
      ],
      "title": "Observation",
      "type": "string"
    },
    "ReviewStatus": {
      "enum": [
        "proposed",
        "accepted",
        "rejected"
      ],
      "title": "ReviewStatus",
      "type": "string"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "properties": {
        "end_col": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Col"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "start_col": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Col"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "start_line",
        "end_line"
      ],
      "title": "SourceSpan",
      "type": "object"
    },
    "StandardFramework": {
      "enum": [
        "attack",
        "d3fend",
        "cwe",
        "owasp_llm",
        "nist_csf"
      ],
      "title": "StandardFramework",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "catalog_status": {
      "$ref": "#/$defs/CatalogStatus",
      "default": "active"
    },
    "catalog_version": {
      "maxLength": 500,
      "title": "Catalog Version",
      "type": "string"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "framework": {
      "$ref": "#/$defs/StandardFramework"
    },
    "id": {
      "description": "Catalog identifier, e.g. T1190, D3-AMED, CWE-639, LLM01:2025",
      "maxLength": 500,
      "title": "Id",
      "type": "string"
    },
    "legacy": {
      "default": false,
      "description": "Imported under an older catalog release",
      "title": "Legacy",
      "type": "boolean"
    },
    "mapped_via": {
      "$ref": "#/$defs/MappedVia"
    },
    "mapping_usage": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "CWE's own Mapping_Notes/Usage for this entry (e.g. Allowed)",
      "title": "Mapping Usage"
    },
    "name": {
      "description": "Name from the catalog, never model text",
      "maxLength": 500,
      "title": "Name",
      "type": "string"
    },
    "observation": {
      "$ref": "#/$defs/Observation"
    },
    "rationale": {
      "maxLength": 500,
      "title": "Rationale",
      "type": "string"
    },
    "review_status": {
      "$ref": "#/$defs/ReviewStatus",
      "default": "proposed"
    },
    "reviewed_by": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewed By"
    },
    "rule_id": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Rule-table row that produced it",
      "title": "Rule Id"
    },
    "url": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Url"
    }
  },
  "required": [
    "framework",
    "id",
    "name",
    "catalog_version",
    "mapped_via",
    "observation",
    "rationale",
    "confidence",
    "evidence"
  ],
  "title": "CWEClassification",
  "type": "object"
}
