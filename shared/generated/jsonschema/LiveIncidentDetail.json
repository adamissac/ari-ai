            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Detail"
        },
        "id": {
          "pattern": "^sev_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Id",
          "type": "string"
        },
        "incident_id": {
          "anyOf": [
            {
              "pattern": "^lin_[0-9A-Za-z_\\-]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Incident Id"
        },
        "kind": {
          "$ref": "#/$defs/LiveEventKind"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "received_at": {
          "format": "date-time",
          "title": "Received At",
          "type": "string"
        },
        "route": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Route"
        },
        "seq": {
          "title": "Seq",
          "type": "integer"
        },
        "severity": {
          "anyOf": [
            {
              "$ref": "#/$defs/LiveSeverity"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_ip": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Ip"
        },
        "status": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Status"
        }
      },
      "required": [
        "id",
        "seq",
        "app_id",
        "app_name",
        "kind",
        "source_ip",
        "route",
        "status",
        "severity",
        "controlled_test",
        "occurred_at",
        "received_at",
        "incident_id",
        "detail"
      ],
      "title": "SecurityEventView",
      "type": "object"
    },
    "VerificationOutcome": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "title": "Attempt",
          "type": "integer"
        },
        "attempts_after": {
          "title": "Attempts After",
          "type": "integer"
        },
        "blocked_after": {
          "title": "Blocked After",
          "type": "integer"
        },
        "checked_at": {
          "format": "date-time",
          "title": "Checked At",
          "type": "string"
        },
        "control_state": {
          "title": "Control State",
          "type": "string"
        },
        "detail": {
          "maxLength": 500,
          "title": "Detail",
          "type": "string"
        },
        "result": {
          "enum": [
            "effective",
            "ineffective",
            "inconclusive",
            "pending"
          ],
          "title": "Result",
          "type": "string"
        }
      },
      "required": [
        "result",
        "control_state",
        "blocked_after",
        "attempts_after",
        "attempt",
        "checked_at",
        "detail"
      ],
      "title": "VerificationOutcome",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actions": {
      "items": {
