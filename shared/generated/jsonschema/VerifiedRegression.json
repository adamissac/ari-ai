{
  "$defs": {
    "EvidenceKind": {
      "enum": [
        "source_span",
        "test_run",
        "sandbox_run",
        "tool_output",
        "artifact",
        "human_input",
        "doc",
        "change_intent",
        "monitoring_event"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "description": "Pointer to a piece of evidence pinned to an exact code version.\n\n``source_span`` evidence must carry ``path`` + ``commit_sha`` + ``span``;\nartifact-backed kinds must carry ``artifact_id`` + ``sha256``.",
      "properties": {
        "artifact_id": {
          "anyOf": [
            {
              "pattern": "^art_[0-9A-Za-z_\\-]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Id"
        },
        "commit_sha": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit Sha"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "path": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "provenance": {
          "description": "Producer and version, e.g. 'code_intelligence.indexer@0.1' or 'agent:probe'",
          "maxLength": 500,
          "title": "Provenance",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceSpan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "symbol": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Qualified symbol name or sym_ id",
          "title": "Symbol"
        }
      },
      "required": [
        "kind",
        "provenance"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "SnapshotRef": {
      "additionalProperties": false,
      "properties": {
        "commit_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Commit Sha",
          "type": "string"
        },
        "index_version": {
          "maxLength": 500,
          "title": "Index Version",
          "type": "string"
        },
        "project_id": {
          "pattern": "^prj_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Project Id",
          "type": "string"
        },
        "repo_id": {
          "pattern": "^rep_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Repo Id",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^snp_[0-9A-Za-z_\\-]{8,64}$",
          "title": "Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "repo_id",
        "commit_sha",
        "snapshot_id",
        "index_version"
      ],
      "title": "SnapshotRef",
      "type": "object"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "properties": {
        "end_col": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Col"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "start_col": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Col"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "start_line",
        "end_line"
      ],
      "title": "SourceSpan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "affected_paths": {
      "items": {
        "maxLength": 1024,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 200,
      "minItems": 1,
      "title": "Affected Paths",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "finding_id": {
      "pattern": "^fnd_[0-9A-Za-z_\\-]{8,64}$",
      "title": "Finding Id",
      "type": "string"
    },
    "patch_id": {
      "pattern": "^pat_[0-9A-Za-z_\\-]{8,64}$",
      "title": "Patch Id",
      "type": "string"
    },
    "snapshot_ref": {
      "$ref": "#/$defs/SnapshotRef"
    },
    "test_paths": {
      "items": {
        "maxLength": 1024,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Test Paths",
      "type": "array"
    },
    "verification_id": {
      "pattern": "^ver_[0-9A-Za-z_\\-]{8,64}$",
      "title": "Verification Id",
      "type": "string"
    }
  },
  "required": [
    "snapshot_ref",
    "finding_id",
    "patch_id",
    "verification_id",
    "affected_paths",
    "test_paths",
    "evidence",
    "created_at"
  ],
  "title": "VerifiedRegression",
  "type": "object"
}
