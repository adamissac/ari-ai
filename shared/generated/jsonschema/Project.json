{
  "$defs": {
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "max_tokens": {
          "default": 400000,
          "minimum": 0,
          "title": "Max Tokens",
          "type": "integer"
        },
        "max_usd": {
          "default": 10.0,
          "minimum": 0,
          "title": "Max Usd",
          "type": "number"
        },
        "max_wall_clock_s": {
          "default": 1800,
          "minimum": 1,
          "title": "Max Wall Clock S",
          "type": "integer"
        }
      },
      "title": "Budget",
      "type": "object"
    },
    "ProjectSettings": {
      "additionalProperties": false,
      "properties": {
        "default_budget": {
          "$ref": "#/$defs/Budget"
        },
        "languages": {
          "items": {
            "maxLength": 500,
            "type": "string"
          },
          "title": "Languages",
          "type": "array"
        },
        "monitoring_policy": {
          "$ref": "#/$defs/TriggerPolicy"
        }
      },
      "title": "ProjectSettings",
      "type": "object"
    },
    "TriggerPolicy": {
      "additionalProperties": false,
      "description": "Monitoring trigger policy (docs/10). Defaults match the MVP table.",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "ignore_paths_only": {
          "description": "If every changed path matches these globs, record without assessment",
          "items": {
            "maxLength": 500,
            "type": "string"
          },
          "title": "Ignore Paths Only",
          "type": "array"
        },
        "min_interval_s": {
          "default": 600,
          "description": "Coalescing window per repo",
          "minimum": 0,
          "title": "Min Interval S",
          "type": "integer"
        },
        "monitoring_budget": {
          "$ref": "#/$defs/Budget",
          "description": "Budget for one push-triggered monitoring run (smaller than default_budget by design)"
        }
      },
      "title": "TriggerPolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "id": {
      "pattern": "^prj_[0-9A-Za-z_\\-]{8,64}$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "maxLength": 500,
      "title": "Name",
      "type": "string"
    },
    "org_id": {
      "pattern": "^org_[0-9A-Za-z_\\-]{8,64}$",
      "title": "Org Id",
      "type": "string"
    },
    "settings": {
      "$ref": "#/$defs/ProjectSettings"
    }
  },
  "required": [
    "id",
    "org_id",
    "name",
    "created_at"
  ],
  "title": "Project",
  "type": "object"
}
