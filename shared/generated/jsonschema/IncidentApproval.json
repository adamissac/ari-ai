{
  "$defs": {
    "ApprovalGate": {
      "enum": [
        "containment",
        "eradication",
        "recovery",
        "closure"
      ],
      "title": "ApprovalGate",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Two-person rule: the decider must differ from the requester and hold the owner role.",
  "properties": {
    "action_summary": {
      "description": "What a human will do (containment/eradication are never executed by the platform)",
      "maxLength": 500,
      "title": "Action Summary",
      "type": "string"
    },
    "decided_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decided At"
    },
    "decided_by": {
      "anyOf": [
        {
          "pattern": "^usr_[0-9A-Za-z_\\-]{8,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decided By"
    },
    "gate": {
      "$ref": "#/$defs/ApprovalGate"
    },
    "reason": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "requested_at": {
      "format": "date-time",
      "title": "Requested At",
      "type": "string"
    },
    "requested_by": {
      "pattern": "^usr_[0-9A-Za-z_\\-]{8,64}$",
      "title": "Requested By",
      "type": "string"
    },
    "status": {
      "enum": [
        "pending",
        "approved",
        "declined"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "gate",
    "status",
    "action_summary",
    "requested_by",
    "requested_at"
  ],
  "title": "IncidentApproval",
  "type": "object"
}
