{
  "$defs": {
    "LabEpisode": {
      "additionalProperties": false,
      "properties": {
        "policy": {
          "title": "Policy",
          "type": "string"
        },
        "scenario": {
          "title": "Scenario",
          "type": "string"
        },
        "episode_seed": {
          "title": "Episode Seed",
          "type": "integer"
        },
        "training_seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Training Seed"
        },
        "total_return": {
          "title": "Total Return",
          "type": "number"
        },
        "compromised": {
          "title": "Compromised",
          "type": "boolean"
        },
        "impact_nodes": {
          "items": {
            "type": "string"
          },
          "title": "Impact Nodes",
          "type": "array"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/LabStep"
          },
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "policy",
        "scenario",
        "episode_seed",
        "training_seed",
        "total_return",
        "compromised",
        "impact_nodes",
        "steps"
      ],
      "title": "LabEpisode",
      "type": "object"
    },
    "LabNode": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "criticality": {
          "title": "Criticality",
          "type": "number"
        },
        "exposed": {
          "title": "Exposed",
          "type": "boolean"
        },
        "finding_severity": {
          "title": "Finding Severity",
          "type": "number"
        }
      },
      "required": [
        "name",
        "criticality",
        "exposed",
        "finding_severity"
      ],
      "title": "LabNode",
      "type": "object"
    },
    "LabNodeState": {
      "additionalProperties": false,
      "properties": {
        "node": {
          "title": "Node",
          "type": "string"
        },
        "alert_rate": {
          "title": "Alert Rate",
          "type": "number"
        },
        "anomaly_score": {
          "title": "Anomaly Score",
          "type": "number"
        },
        "monitoring_level": {
          "title": "Monitoring Level",
          "type": "number"
        },
        "rate_limited": {
          "title": "Rate Limited",
          "type": "boolean"
        },
        "isolated": {
          "title": "Isolated",
          "type": "boolean"
        },
        "reassessment_pending": {
          "title": "Reassessment Pending",
          "type": "boolean"
        },
        "hidden_stage_ground_truth": {
          "description": "Replay visualization only. The policy never observes this.",
          "enum": [
            "none",
            "foothold",
            "escalated",
            "impact"
          ],
          "title": "Hidden Stage Ground Truth",
          "type": "string"
        }
      },
      "required": [
        "node",
        "alert_rate",
        "anomaly_score",
        "monitoring_level",
        "rate_limited",
        "isolated",
        "reassessment_pending",
        "hidden_stage_ground_truth"
      ],
      "title": "LabNodeState",
      "type": "object"
    },
    "LabPolicyMetrics": {
      "additionalProperties": false,
      "properties": {
        "policy": {
          "title": "Policy",
          "type": "string"
        },
        "pooled": {
          "additionalProperties": {
            "$ref": "#/$defs/MetricCI"
          },
          "title": "Pooled",
          "type": "object"
        },
        "per_scenario": {
          "additionalProperties": {
            "additionalProperties": {
              "$ref": "#/$defs/MetricCI"
            },
            "type": "object"
          },
          "title": "Per Scenario",
          "type": "object"
        }
      },
      "required": [
        "policy",
        "pooled",
        "per_scenario"
      ],
      "title": "LabPolicyMetrics",
      "type": "object"
    },
    "LabScenario": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "config_hash": {
          "title": "Config Hash",
          "type": "string"
        },
        "split": {
          "const": "eval",
          "title": "Split",
          "type": "string"
        },
        "horizon": {
          "title": "Horizon",
          "type": "integer"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/LabNode"
          },
          "title": "Nodes",
          "type": "array"
        },
        "edges": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Edges",
          "type": "array"
        }
      },
      "required": [
        "name",
        "config_hash",
        "split",
        "horizon",
        "nodes",
        "edges"
      ],
      "title": "LabScenario",
      "type": "object"
    },
    "LabStep": {
      "additionalProperties": false,
      "properties": {
        "t": {
          "title": "T",
          "type": "integer"
        },
        "action": {
          "title": "Action",
          "type": "string"
        },
        "reward": {
          "title": "Reward",
          "type": "number"
        },
        "reward_components": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Reward Components",
          "type": "object"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/LabNodeState"
          },
          "title": "Nodes",
          "type": "array"
        }
      },
      "required": [
        "t",
        "action",
        "reward",
        "reward_components",
        "nodes"
      ],
      "title": "LabStep",
      "type": "object"
    },
    "MetricCI": {
      "additionalProperties": false,
      "properties": {
        "mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mean"
        },
        "ci95": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            }
          ],
          "title": "Ci95",
          "type": "array"
        }
      },
      "required": [
        "mean",
        "ci95"
      ],
      "title": "MetricCI",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "env_id": {
      "default": "DefenseSimEnv-v0",
      "title": "Env Id",
      "type": "string"
    },
    "simulation_only": {
      "const": true,
      "default": true,
      "title": "Simulation Only",
      "type": "boolean"
    },
    "caveat": {
      "default": "Results are from a simulated environment and do not establish real-world effectiveness.",
      "title": "Caveat",
      "type": "string"
    },
    "source_run": {
      "title": "Source Run",
      "type": "string"
    },
    "git_sha": {
      "title": "Git Sha",
      "type": "string"
    },
    "checkpoint_sha256": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Checkpoint Sha256",
      "type": "object"
    },
    "training_seeds": {
      "items": {
        "type": "integer"
      },
      "title": "Training Seeds",
      "type": "array"
    },
    "episodes_per_config_per_seed": {
      "title": "Episodes Per Config Per Seed",
      "type": "integer"
    },
    "scenarios": {
      "items": {
        "$ref": "#/$defs/LabScenario"
      },
      "title": "Scenarios",
      "type": "array"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/LabPolicyMetrics"
      },
      "title": "Metrics",
      "type": "array"
    },
    "episodes": {
      "items": {
        "$ref": "#/$defs/LabEpisode"
      },
      "title": "Episodes",
      "type": "array"
    }
  },
  "required": [
    "source_run",
    "git_sha",
    "checkpoint_sha256",
    "training_seeds",
    "episodes_per_config_per_seed",
    "scenarios",
    "metrics",
    "episodes"
  ],
  "title": "DefenseLabBundle",
  "type": "object"
}
